-- Farm a pie para kaijus SIN beam (ej. Gezora): entre los edificios,
-- spam de ataques 1-3 con CD/energía real + noclip. Usa SU PROPIA lista
-- (no prende "Beam a edificios": ese toggle es solo para beam).
local function RefreshGroundBuildings()
	local nowB = os.clock()
	if (nowB - (State.LastGroundScan or 0)) < 30 and #State.GroundBuildings > 0 then return end
	State.LastGroundScan = nowB
	State.GroundBuildings = {}
	State.GroundDead = State.GroundDead or {}
	-- Filtro por tipos elegidos (vacío = todos): "Building19"->"Building".
	local typeFilter = Config.QuestGround.BuildTypes
	local hasFilter = typeFilter and next(typeFilter) ~= nil
	local function typeOk(name)
		if not hasFilter then return true end
		local base = tostring(name):gsub("%d+$", "")
		return typeFilter[base] == true
	end
	pcall(function()
		local map = Workspace:FindFirstChild("Map")
		for _, fname in ipairs({ "CityFolder", "Tokyo" }) do
			local folder = map and map:FindFirstChild(fname)
			if folder then
				for _, m in ipairs(folder:GetDescendants()) do
					if #State.GroundBuildings >= 60 then break end
					-- Ventana avanzante: salta los ya destruidos para no
					-- estancarse en los primeros 60 cuando caen.
					if m:IsA("Model") and m.Parent and m:FindFirstChildWhichIsA("BasePart", true) and typeOk(m.Name) then
						local dd = State.GroundDead[m]
						if not dd or (nowB - dd) > 300 then
							if dd then State.GroundDead[m] = nil end
							local ok, pv = pcall(function() return m:GetPivot().Position end)
							if ok then table.insert(State.GroundBuildings, { Model = m, Pos = pv }) end
						end
					end
				end
			end
		end
	end)
end

local function QuestGroundTick()
	if State.Unloaded then return end
	-- Manual = prendido por ti (no por el quest). Si el quest se apaga y
	-- no hay manual, teardown completo (igual que el auto kill).
	local manual = Config.QuestGround.Enabled and not State.QuestDroveGround
	if not State.QuestGround and not manual then return end
	if not manual and not Config.Quests.Auto then
		QuestGroundSet(false)
		return
	end
	local now = os.clock()
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myKaiju or not myHRP then return end
	-- Sin noclip: dejaba partes sin colisión (movimiento raro, caídas).
	-- El teleport cada 0.25s ya mantiene la posición sin necesitarlo.
	-- Sin ancla (congela tu posición en el servidor) y sin estar ADENTRO
	-- (buguea tu cámara): pegado FUERA de la superficie, fijado CADA
	-- FRAME para que no se note caída. Solo el disparo va con throttle.
	RefreshGroundBuildings()
	-- Lista viva (los destruidos salen del mapa: Parent nil -> se marcan
	-- para que el próximo escaneo avance la ventana).
	local alive = {}
	State.GroundDead = State.GroundDead or {}
	pcall(function()
		for _, b in ipairs(State.GroundBuildings) do
			if b.Model and b.Model.Parent and b.Pos then
				table.insert(alive, b)
			elseif b.Model then
				State.GroundDead[b.Model] = os.clock()
			end
		end
	end)
	if #alive == 0 then
		State.LastGroundScan = 0 -- fuerza re-escaneo ya
		return
	end
	-- Modelo en foco: quedarse hasta tumbarlo (sin partes vivas) o máx
	-- 15s (por si es inmune). Así los grandes (hasta 19 partes) caen
	-- completos en vez de quedar a medias por rotar cada 3s.
	local curM = State.GroundModel
	local function liveParts(m)
		local t = {}
		pcall(function()
			if m and m.Parent then
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("BasePart") then table.insert(t, d) end
				end
			end
		end)
		return t
	end
	local curParts = liveParts(curM)
	if #curParts == 0 or (now - (State.LastGroundHop or 0)) > 8 then
		State.LastGroundHop = now
		-- Edificio con partes vivas más cercano (distinto al actual si hay).
		local bestM, bestMd = nil, math.huge
		local firstAlt, firstAltD = nil, math.huge
		pcall(function()
			for _, b in ipairs(alive) do
				local m = b.Model
				if m and m.Parent and #liveParts(m) > 0 then
					local d = (b.Pos - myHRP.Position).Magnitude
					if m ~= curM and d < bestMd then bestM, bestMd = m, d end
					if d < firstAltD then firstAlt, firstAltD = m, d end
				end
			end
		end)
		curM = bestM or firstAlt
		State.GroundModel = curM
		curParts = liveParts(curM)
	end
	if #curParts == 0 then
		State.GroundModel = nil
		State.LastGroundHop = 0
		return
	end
	-- Parte viva más cercana DEL MISMO edificio.
	local part, partD = nil, math.huge
	pcall(function()
		for _, d in ipairs(curParts) do
			local dd = (d.Position - myHRP.Position).Magnitude
			if dd < partD then part, partD = d, dd end
		end
	end)
	if not part then return end
	State.GroundCurrent = part
	-- Pegado FUERA de la parte (+3 hacia afuera, mirándola): a quemarropa
	-- pero sin meter la cámara al mesh. Se fija cada frame, salvo los
	-- primeros 3s post-spawn (asentamiento; el disparo sigue).
	if SpawnSettled() then
	pcall(function()
		local pp = part.Position
		local piv = nil
		pcall(function()
			local pm = part.Parent
			if pm then piv = pm:GetPivot().Position end
		end)
		if not piv then piv = pp end
		local out = pp - piv
		if out.Magnitude < 1 then out = Vector3.new(0, 1, 0) end
		out = out.Unit
		myHRP.CFrame = CFrame.lookAt(pp + out * 3, pp)
	end)
	end
	pcall(function()
		if State.GroundStatusLbl and (now - (State.LastGroundLbl or 0)) > 2 then
			State.LastGroundLbl = now
			local pm = part.Parent
			State.GroundStatusLbl:SetText("Edificios vivos: " .. #alive .. "\nActual: " .. tostring(pm and pm.Name or "?"))
		end
	end)
	-- Ataques configurados en Farm > Farm Builds: primero listo con CD
	-- real + energía (nunca beam). Cadencia rápida para farmear veloz.
	if now >= (State.NextGroundAttack or 0) then
		local stats = GetAttackStats()
		local en = myKaiju:GetAttribute("Energy") or 0
		local order = { "Attack1", "Attack2", "Attack3", "Attack4", "Attack5" }
		local fired = false
		for _, a in ipairs(order) do
			if Config.QuestGround.Attacks[a] then
				local s = stats[a]
				if s then
					local readyAt = (State.GroundCDs and State.GroundCDs[a]) or 0
					if now >= readyAt then
						FireSkill(a)
						State.GroundCDs = State.GroundCDs or {}
						State.GroundCDs[a] = now + (s.cd or 3)
						fired = true
						break
					end
				end
			end
		end
		State.NextGroundAttack = now + (fired and 0.3 or 1.0)
	end
end

-- Enciende/apaga el farm de suelo (quest lo maneja, toggle manual aparte).
-- Solo apaga lo que el propio quest encendió (drove).
local function QuestGroundSet(on)
	if on then
		if not Config.QuestGround.Enabled then
			Config.QuestGround.Enabled = true
			State.QuestDroveGround = true
			pcall(function() local t = Tgl("QuestGroundFarm") if t then t:SetValue(true) end end)
		end
		State.QuestGround = true
	else
		State.QuestGround = false
		State.GroundNoclipModel = nil
		pcall(function()
			local mk = GetMyKaiju(false)
			local hrp = mk and mk:FindFirstChild("HumanoidRootPart")
			if hrp then hrp.Anchored = false end
		end)
		if Config.QuestGround.Enabled and State.QuestDroveGround then
			Config.QuestGround.Enabled = false
			State.QuestDroveGround = false
			pcall(function() local t = Tgl("QuestGroundFarm") if t then t:SetValue(false) end end)
		end
		if not Config.Kill.Enabled then pcall(SetGhostNoclip, false) end
	end
end

local function AutoFarmTick()
	if not Config.Farm.AutoFarm or State.Unloaded then return end
	local now = os.clock()
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myKaiju or not myHRP then return end
	-- Pin anti-drift: mientras tu beam sigue activo te clavas donde
	-- empezó (el disparo te empuja; sin pin te vas moviendo solo).
	local beamOn = false
	pcall(function()
		local bf = Workspace:FindFirstChild("Beam")
		beamOn = bf ~= nil and bf:FindFirstChild(LocalPlayer.Name .. "_Beam") ~= nil
	end)
	if beamOn then
		if not State.BeamLockCF then
			State.BeamLockCF = myHRP.CFrame
		end
		pcall(function() myHRP.CFrame = State.BeamLockCF end)
		return -- ni reposiciona ni re-apunta a mitad del tiro
	else
		State.BeamLockCF = nil
	end
	if (now - (State.LastAutoTick or 0)) < 0.5 then return end
	State.LastAutoTick = now
	-- Misiones de edificios: plataforma sobre el centroide de CityFolder
	-- (las islas del juego no están donde están los edificios).
	local skyTop
	if State.QuestSkyTop then
		skyTop = State.QuestSkyTop
	else
		local isl = NearestIsland(myHRP.Position)
		if not isl then return end
		skyTop = Vector3.new(isl.Pos.X, isl.Pos.Y + (Config.Farm.SkyAlt or 150), isl.Pos.Z)
	end
	EnsureSkyPlatform(skyTop)
	-- Asentamiento post-spawn: 3s sin moverte (el disparo sigue).
	if SpawnSettled() then
	-- Si te tumban o caes, te devuelve arriba (mirando al objetivo)
	if myHRP.Position.Y < skyTop.Y - 25 then
		local face = CurrentFarmTarget()
		pcall(function()
			local fp = face and SilentPoint(face)
			local dest = Vector3.new(skyTop.X, skyTop.Y + 4, skyTop.Z)
			if fp then myHRP.CFrame = CFrame.lookAt(dest, fp)
			else myHRP.CFrame = CFrame.new(dest) end
		end)
	else
		-- Apunta con el cuerpo sin moverte (el beam sigue al objetivo).
		-- Solo re-apunta si el ángulo supera ~10° (máx 1/s): si no, el
		-- cuerpo vibra/gira solo persiguiendo micro-movimientos.
		local face = CurrentFarmTarget()
		if face then
			local fp = SilentPoint(face)
			if fp and (now - (State.LastAimAt or 0)) >= 1 then
				local want = fp - myHRP.Position
				if want.Magnitude > 1 then
					local cur = myHRP.CFrame.LookVector
					local dot = math.clamp(cur:Dot(want.Unit), -1, 1)
					if math.acos(dot) > 0.17 then
						State.LastAimAt = now
						pcall(function()
							myHRP.CFrame = CFrame.lookAt(myHRP.Position, fp)
						end)
					end
				end
			end
		end
	end
	end
	-- Dispara beams con CDs propios por skill (no uno solo): rota Attack5
	-- (beam real, con power) y Attack4 en cuanto cada uno está listo.
	-- En misión de beam EXPLÍCITO solo vale Attack5.
	if now >= (State.NextBeamAt or 0) then
		State.NextBeamAt = now + 1
		local st = GetAttackStats()
		local en = myKaiju:GetAttribute("Energy") or 0
		local pw = myKaiju:GetAttribute("Power") or 0
		local order = State.QuestBeamOnly and { "Attack5" }
			or { "Attack5", "Attack4" }
		for _, sk in ipairs(order) do
			local s = st[sk]
			if s then
				State.BeamCDs = State.BeamCDs or {}
				local readyAt = State.BeamCDs[sk] or 0
				local pwOk = (sk ~= "Attack5") or (pw >= BeamPowerNeed())
				if now >= readyAt and en >= (s.en or 0) and pwOk then
					FireSkill(sk)
					State.BeamCDs[sk] = now + (s.cd or 30)
					break
				end
			end
		end
	end
end

-- Fin preciso: según cómo empezó (objeto Beam o atributo). Ver HasMyBeam.
-- Beam alto: al detectar tu beam te sube a la plataforma y TE MANTIENE
-- ahí hasta que el beam acaba; luego vuelves a tu sitio anterior.
local function HasMyBeam()
	local has = false
	pcall(function()
		local bf = Workspace:FindFirstChild("Beam")
		has = bf ~= nil and bf:FindFirstChild(LocalPlayer.Name .. "_Beam") ~= nil
	end)
	return has
end

local function BeamAltoTick()
	if not Config.Farm.BeamAlto or Config.Farm.AutoFarm or State.Unloaded then return end
	local myKaiju = GetMyKaiju()
	local attrFire = myKaiju and myKaiju:GetAttribute("Attacking") == true
	local beamObj = HasMyBeam()
	local firing = attrFire or beamObj
	local now = os.clock()
	-- Flancos SEPARADOS: si no, al volver con el objeto aún vivo se
	-- re-dispara solo (guardaba la plataforma como origen: el doble salto).
	local attrRise = attrFire and not State.BeamAltoPrevAttr
	local objRise = beamObj and not State.BeamAltoPrevObj
	State.BeamAltoPrevAttr = attrFire
	State.BeamAltoPrevObj = beamObj
	if (attrRise or objRise) and not State.BeamAltoReturn then
		local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
		if not myHRP then State.BeamAltoPrev = firing return end
		State.BeamAltoReturn = myHRP.CFrame
		State.BeamAltoMode = beamObj and "beam" or "attr"
		State.BeamAltoEndAt = nil
		State.BeamAltoStartAt = now
		local isl = NearestIsland(myHRP.Position)
		if isl then
			local skyTop = Vector3.new(isl.Pos.X, isl.Pos.Y + (Config.Farm.SkyAlt or 70), isl.Pos.Z)
			State.AltoTop = skyTop
			EnsureSkyPlatform(skyTop)
			pcall(function()
				myHRP.CFrame = CFrame.new(Vector3.new(skyTop.X, skyTop.Y + 4, skyTop.Z))
			end)
		end
	elseif firing and State.BeamAltoReturn then
		local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
		if not myHRP then State.BeamAltoPrev = firing return end
		if State.AltoTop and (now - (State.LastAltoPin or 0)) >= 0.25 then
			State.LastAltoPin = now
			if myHRP.Position.Y < State.AltoTop.Y - 15 then
				local top = State.AltoTop
				pcall(function()
					local cf = myHRP.CFrame
					myHRP.CFrame = CFrame.new(Vector3.new(cf.Position.X, top.Y + 4, cf.Position.Z)) * (cf - cf.Position)
				end)
			end
		end
		-- Fin: lo PRIMERO que ocurra según el modo (objeto fuera +0.3s,
		-- atributo caído +0.2s). Sin re-disparos: los flancos ya quedaron atrás.
		if State.BeamAltoMode == "beam" and not beamObj then
			if not State.BeamAltoEndAt then State.BeamAltoEndAt = now + 0.3 end
		elseif State.BeamAltoMode == "attr" and not attrFire then
			if not State.BeamAltoEndAt then State.BeamAltoEndAt = now + 0.2 end
		else
			State.BeamAltoEndAt = nil
		end
		if State.BeamAltoEndAt and now >= State.BeamAltoEndAt then
			firing = false
		end
	end
	if not firing and State.BeamAltoPrev and State.BeamAltoReturn then
		local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
		if myHRP then pcall(function() myHRP.CFrame = State.BeamAltoReturn end) end
		State.BeamAltoReturn = nil
		State.AltoTop = nil
		State.BeamAltoEndAt = nil
	end
	State.BeamAltoPrev = firing
end

-- ================= SILENT AIMBOT (hooks, tu mira no se mueve) =================
-- Engancha lo que el juego LEE para apuntar (igual que un silent universal):
--  1) Mouse.Hit / Mouse.Target -> devuelve al enemigo.
--  2) workspace:Raycast de puntería -> redirige el rayo al enemigo.
-- Objetivo = enemigo más cercano a TU MOUSE dentro del círculo FOV.
-- Tu cursor y tu cámara no se mueven: es silent de verdad.
-- Forward: FindBoss se define en la sección Boss (después). Como los hooks
-- llaman en runtime (post-carga), el local ya estará asignado.
local FindBoss
local function GetSilentTarget()
	-- Con boss farm: SIEMPRE al jefe (no es opcional, va primero que todo)
	if Config.BossFarm.Enabled then
		local boss = FindBoss()
		if boss then return boss end
	end
	-- Farm tiene prioridad: rota por la lista sin importar el mouse
	local farm = CurrentFarmTarget()
	if farm then return farm end
	local myKaiju = GetMyKaiju()
	if not myKaiju then return nil end
	local myHRP = myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then return nil end
	local mOk, m = pcall(function() return UserInputService:GetMouseLocation() end)
	if not mOk then return nil end
	local best, bestD = nil, Config.Aim.FOV
	for _, enemy in ipairs(GetEnemyKaijus()) do
		local hrp = enemy:FindFirstChild("HumanoidRootPart")
		if hrp then
			if (hrp.Position - myHRP.Position).Magnitude <= Config.SilentAim.Range then
				local ok, sp, onScreen = pcall(function() return Camera:WorldToViewportPoint(hrp.Position) end)
				if ok and onScreen then
					local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(m.X, m.Y)).Magnitude
					if d < bestD then best, bestD = enemy, d end
				end
			end
		end
	end
	return best
end

local function SilentGated()
	if State.Unloaded then return false end
	local farmOn = IsFarmActive() and CurrentFarmTarget() ~= nil
	local bossOn = Config.BossFarm.Enabled and FindBoss() ~= nil
	if not Config.SilentAim.Enabled and not farmOn and not bossOn then return false end
	if Config.SilentAim.OnlyWhileAttacking and not farmOn and not bossOn then
		local myKaiju = GetMyKaiju()
		if not myKaiju or myKaiju:GetAttribute("Attacking") ~= true then return false end
	end
	return true
end

local function InstallSilentHooks()
	if State.IndexOld or State.NamecallOld then return true end
	if typeof(hookmetamethod) ~= "function" or typeof(newcclosure) ~= "function" then
		warn("[Silent] Sin hookmetamethod/newcclosure")
		return false
	end
	pcall(function()
		State.SilentMouse = LocalPlayer:GetMouse()
	end)
	pcall(function()
		State.IndexOld = hookmetamethod(game, "__index", newcclosure(function(self, k)
			if (k == "Hit" or k == "Target") and self == State.SilentMouse and SilentGated() then
				local isExec = false
				pcall(function() isExec = checkcaller() end)
				if not isExec then
					local target = GetSilentTarget()
					local pos = target and SilentPoint(target)
					if pos then
						if k == "Hit" then return CFrame.new(pos) end
						return SilentTargetObj(target)
					end
				end
			end
			return State.IndexOld(self, k)
		end))
	end)
	pcall(function()
		State.NamecallOld = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			local method = getnamecallmethod()
			if method == "Raycast" and self == Workspace and SilentGated() then
				local isExec = false
				pcall(function() isExec = checkcaller() end)
				if not isExec then
					local args = { ... }
					local origin, dir = args[1], args[2]
					if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" and dir.Magnitude > 100 then
						local target = GetSilentTarget()
						local pos = target and SilentPoint(target)
						if pos then
							local toT = pos - origin
							if toT.Magnitude <= dir.Magnitude + 100 then
								args[2] = toT.Unit * dir.Magnitude
								return State.NamecallOld(self, unpack(args))
							end
						end
					end
				end
			end
			return State.NamecallOld(self, ...)
		end))
	end)
	local ok = (State.IndexOld ~= nil) or (State.NamecallOld ~= nil)
	if ok then print("[Silent] Hooks instalados (Mouse + Raycast)") end
	return ok
end

local function RemoveSilentHooks()
	if State.IndexOld then
		pcall(function() hookmetamethod(game, "__index", State.IndexOld) end)
		State.IndexOld = nil
	end
	if State.NamecallOld then
		pcall(function() hookmetamethod(game, "__namecall", State.NamecallOld) end)
		State.NamecallOld = nil
	end
end

