-- Punto de mira para cualquier objetivo (kaiju con HRP o edificio con pivot)
-- Parte cicladora: con Todas las partes ON, rota por TODAS las
-- BaseParts del objetivo (cabeza, torso, extremidades) en vez de solo
-- el pecho. Ciclo por modelo para consistencia Hit/Target.
local function SilentCyclePart(target)
	State.SilentCycle = State.SilentCycle or {}
	State.SilentCycleN = (State.SilentCycleN or 0) + 1
	if State.SilentCycleN > 200 then
		State.SilentCycle, State.SilentCycleN = {}, 0
	end
	local parts = {}
	pcall(function()
		for _, d in ipairs(target:GetDescendants()) do
			if d:IsA("BasePart") then table.insert(parts, d) end
		end
	end)
	if #parts == 0 then return nil end
	local i = (State.SilentCycle[target] or 0) % #parts + 1
	State.SilentCycle[target] = i
	return parts[i]
end

local function SilentPoint(target)
	if Config.SilentAim.AllParts and type(target) ~= "string" then
		local p = SilentCyclePart(target)
		if p then return p.Position end
	end
	local p = target:FindFirstChild(Config.SilentAim.TargetPart) or target:FindFirstChild("HumanoidRootPart")
	if p then return p.Position end
	local ok, pv = pcall(function() return target:GetPivot().Position end)
	if ok then return pv end
	return nil
end

local function SilentTargetObj(target)
	if Config.SilentAim.AllParts and type(target) ~= "string" then
		local p = SilentCyclePart(target)
		if p then return p end
	end
	local p = target:FindFirstChild(Config.SilentAim.TargetPart) or target:FindFirstChild("HumanoidRootPart")
	if p then return p end
	if target:IsA("BasePart") then return target end
	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("BasePart") then return d end
	end
	return nil
end

