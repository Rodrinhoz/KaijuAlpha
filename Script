-- Rotación inteligente del boss (CD real + energía): BossFarmTick.
local function BossFarmTick()
	if not Config.BossFarm.Enabled or State.Unloaded or State.BossDodging then return end
	local now = os.clock()
	if (now - (State.LastBossFarmTick or 0)) < 0.25 then return end
	State.LastBossFarmTick = now
	local boss = FindBoss()
	if not boss then UnweldBoss() return end
	-- REGLA sala de espera (toggle "Solo si esperé"): si el boss inició
	-- sin ti, no farmear (el daño no contaría). Solo válido si estabas
	-- en espera antes. Apagado = ataca igual.
	if State.BossStartedWithMe == false and Config.BossFarm.WaitOnly ~= false then
		UnweldBoss()
		if (now - (State.LastBossRuleWarn or 0)) > 30 then
			State.LastBossRuleWarn = now
			Notify("Boss sin ti en sala: no farmeo (no cuenta)", 4)
		end
		return
	end
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	local bHRP = boss:FindFirstChild("HumanoidRootPart")
	if not myKaiju or not myHRP or not bHRP then return end
	local wantDist = Config.BossFarm.StickDist or 12
	-- Punto detrás del jefe (sus cajas van adelante), a su altura
	local bLook = bHRP.CFrame.LookVector
	bLook = Vector3.new(bLook.X, 0, bLook.Z)
	if bLook.Magnitude < 0.001 then bLook = Vector3.new(0, 0, 1) end
	bLook = bLook.Unit
	local dest = Vector3.new(
		bHRP.Position.X - bLook.X * wantDist,
		bHRP.Position.Y,
		bHRP.Position.Z - bLook.Z * wantDist)
	local welded = State.BossWeld and State.BossWeld.Parent
	if SpawnSettled() and (not welded or (myHRP.Position - dest).Magnitude > wantDist + 8) then
		-- (Re)suelda: te coloca y quedas pegado, sin más saltos.
		-- Nada los primeros 3s post-spawn (asentamiento).
		pcall(function()
			myHRP.CFrame = CFrame.lookAt(dest, bHRP.Position)
		end)
		WeldToBoss(myHRP, bHRP)
	end
	-- Rotación inteligente: dispara el primero listo (CD real + energía +
	-- power). El Attack5 pide Power (DFF: 100): sin power se salta en vez
	-- de dispararlo al vacío y comerse su CD. Ritmo máximo (0.25s).
	if now >= (State.NextBossAttack or 0) then
		local stats = GetAttackStats()
		local en = myKaiju:GetAttribute("Energy") or 0
		local pw = myKaiju:GetAttribute("Power") or 0
		local kn = myKaiju:GetAttribute("KaijuName")
		if State.BossPwKaiju ~= kn then
			State.BossPwKaiju = kn
			State.BossPwNeeds = {}
			pcall(function()
				local kd = ReplicatedStorage:FindFirstChild("Shared")
				local km = kd and type(kn) == "string" and kd:FindFirstChild("KaijuData") and kd.KaijuData:FindFirstChild(kn)
				local data = km and require(km)
				local st = data and data.KaijuData and data.KaijuData.AttackStatics
				if type(st) == "table" then
					for _, a in ipairs({ "Attack1", "Attack2", "Attack3", "Attack4", "Attack5" }) do
						local sa = st[a]
						State.BossPwNeeds[a] = (type(sa) == "table" and type(sa.Power) == "number") and sa.Power or false
					end
				end
			end)
		end
		local order = { "Attack1", "Attack2", "Attack3", "Attack4", "Attack5" }
		local fired = false
		for _, a in ipairs(order) do
			if Config.BossFarm.Attacks[a] then
				local s = stats[a] or stats.Attack1
				local readyAt = (State.BossCDs and State.BossCDs[a]) or 0
				local pwNeed = State.BossPwNeeds and State.BossPwNeeds[a]
				if pwNeed and pw < pwNeed then
					-- sin power: ni se intenta
				elseif now >= readyAt and en >= (s.en or 0) then
					FireSkill(a)
					State.BossCDs = State.BossCDs or {}
					State.BossCDs[a] = now + (s.cd or 3)
					State.NextBossAttack = now + 0.25
					fired = true
					break
				end
			end
		end
		if not fired then
			State.NextBossAttack = now + 0.25
		end
	end
end

