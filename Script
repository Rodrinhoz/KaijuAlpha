-- Requisitos tipo "Godzilla 2019 (Kills 10/10, Level 75/75 ✓)"
local function KaijuReqText(name, plain)
	local reqs = nil
	pcall(function()
		local st = require(ReplicatedStorage.Shared.KaijuData).Kaiju[name]
		if type(st) == "table" then reqs = st.Requirement end
	end)
	if type(reqs) ~= "table" then return "", true end
	-- Ordenado para display estable (Kills antes que Level, grupos A-Z)
	local keys = {}
	for k in pairs(reqs) do table.insert(keys, k) end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
	local parts, allOk = {}, true
	for _, k in ipairs(keys) do
		local v = reqs[k]
		if type(v) == "number" then
			local have = PlayerInvItem(k)
			local ok = have >= v
			if not ok then allOk = false end
			if plain then
				table.insert(parts, string.format("%s %d/%d", k, have, v))
			else
				table.insert(parts, string.format("%s %d/%d%s", k, have, v, ok and " ✓" or " ✗"))
			end
		elseif type(v) == "table" then
			local owned = OwnsKaiju(k)
			local subkeys = {}
			for k2 in pairs(v) do table.insert(subkeys, k2) end
			table.sort(subkeys)
			local sub, sok = {}, owned
			for _, k2 in ipairs(subkeys) do
				local need = v[k2]
				local have = PlayerKaijuStat(k, k2)
				local ok = have >= need
				if not ok then sok = false end
				table.insert(sub, string.format("%s %d/%d", k2, have, need))
			end
			if not sok then allOk = false end
			if plain then
				table.insert(parts, string.format("%s (%s)", k, table.concat(sub, ", ")))
			else
				table.insert(parts, string.format("%s%s (%s)%s", k, owned and "" or " [no poseído]", table.concat(sub, ", "), sok and " ✓" or " ✗"))
			end
		else
			table.insert(parts, tostring(v))
		end
	end
	if plain then return table.concat(parts, "\n"), allOk end
	return table.concat(parts, " | "), allOk
end

local function ShopReqText(name)
	local price = nil
	pcall(function()
		local st = require(ReplicatedStorage.Shared.KaijuData).Kaiju[name]
		if type(st) == "table" then price = st.Price end
	end)
	local cells = MyCells()
	local base
	if type(price) == "number" then
		if price >= 1000000000 then base = "no disponible"
		elseif cells >= price then base = FormatCells(price) .. " Cells ✓"
		else base = FormatCells(price) .. " Cells (te faltan " .. FormatCells(price - cells) .. ")" end
	elseif price == nil then
		base = "sin precio"
	else
		base = "requiere " .. tostring(price)
	end
	local reqs = KaijuReqText(name)
	if reqs ~= "" then base = base .. "\nReq: " .. reqs end
	return base
end

local function FormatCells(n)
	n = math.floor(n)
	local s = tostring(n)
	local out = ""
	while #s > 3 do out = "," .. s:sub(-3) .. out s = s:sub(1, -4) end
	return s .. out
end

