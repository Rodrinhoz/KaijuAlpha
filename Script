local function GetAvailableQuests()
	local quests = GetQuests()
	if not quests then return {} end
	local available = {}
	-- Daily quests
	if quests.Daily then
		for _, q in pairs(quests.Daily) do
			if not q.Completed and not q.Claimed and not q.Locked then
				table.insert(available, { Type = "Daily", Quest = q })
			elseif q.Completed and not q.Claimed and not q.Locked then
				table.insert(available, { Type = "Daily", Quest = q, ReadyToClaim = true })
			end
		end
	end
	-- Premium quests
	if quests.Premium then
		for _, q in pairs(quests.Premium) do
			if not q.Completed and not q.Claimed and not q.Locked then
				table.insert(available, { Type = "Premium", Quest = q })
			elseif q.Completed and not q.Claimed and not q.Locked then
				table.insert(available, { Type = "Premium", Quest = q, ReadyToClaim = true })
			end
		end
	end
	return available
end

local function SelectBestQuest()
	local available = GetAvailableQuests()
	if #available == 0 then return nil end
	
	-- Priority: Ready to claim > Kill/Any > Walk/Swim/Fly > BuildingBeam > BuildingDestroy > BossKill/Damage > PlayTime
	local priority = {
		Kill = 10, KillTarget = 9, KillAny = 9,
		Walk = 8, Swimming = 8, Flying = 8,
		BuildingBeam = 7, BuildingDestroy = 6,
		BossKill = 5, BossDamage = 5,
		PlayTime = 4,
	}
	
	table.sort(available, function(a, b)
		local pa = a.ReadyToClaim and 100 or (priority[a.Quest.Category] or 0)
		local pb = b.ReadyToClaim and 100 or (priority[b.Quest.Category] or 0)
		if pa ~= pb then return pa > pb end
		-- Prefer higher progress ratio
		local progA = a.Quest.Goal > 0 and (a.Quest.Progress / a.Quest.Goal) or 0
		local progB = b.Quest.Goal > 0 and (b.Quest.Progress / b.Quest.Goal) or 0
		return progA > progB
	end)
	
	return available[1]
end

