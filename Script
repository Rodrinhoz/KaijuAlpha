local function FetchServers()
	local ok, result = pcall(function()
		return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
	end)
	if not ok then return nil end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, result)
	if ok2 then return data end
	return nil
end

ServerGroup:AddButton({ Text = "Server Hop", Func = function()
	Notify("Buscando servidor...", 3)
	local data = FetchServers()
	local servers = {}
	if data and data.data then
		for _, s in ipairs(data.data) do
			if s.playing < s.maxPlayers and s.id ~= game.JobId then
				table.insert(servers, s.id)
			end
		end
	end
	if #servers > 0 then
		TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
	else
		Notify("No se encontraron servidores", 3)
	end
end })

ServerGroup:AddButton({ Text = "Hop Low Population", Func = function()
	Notify("Buscando servidor vacío...", 3)
	local data = FetchServers()
	local best, lowest = nil, math.huge
	if data and data.data then
		for _, s in ipairs(data.data) do
			if s.playing < s.maxPlayers and s.id ~= game.JobId and s.playing < lowest then
				lowest, best = s.playing, s.id
			end
		end
	end
	if best then
		TeleportService:TeleportToPlaceInstance(game.PlaceId, best, LocalPlayer)
	else
		Notify("No se encontraron servidores", 3)
	end
end })

