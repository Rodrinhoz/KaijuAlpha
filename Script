local cloneref = (cloneref or clonereference or function(instance) return instance end)

-- AutoExec: solo corre en Kaiju Alfa (si inyectas en otro juego, no hace nada)
if game.PlaceId ~= 127403135954624 then return end
local CoreGui = cloneref(game:GetService("CoreGui"))
local Players = cloneref(game:GetService("Players"))
local RunService = cloneref(game:GetService("RunService"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local Workspace = cloneref(game:GetService("Workspace"))
local TeleportService = cloneref(game:GetService("TeleportService"))
local HttpService = cloneref(game:GetService("HttpService"))
local ReplicatedStorage = cloneref(game:GetService("ReplicatedStorage"))
local Camera = Workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
	LocalPlayer = Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
	LocalPlayer = Players.LocalPlayer
end

-- UNLOAD TOTAL: al ejecutar, mata TODAS las copias anteriores (llave nueva
-- y llave legacy de antes del renombre), si no quedan handlers huérfanos
-- de RightControl peleando con el nuevo.
pcall(function()
	if getgenv and getgenv().KaijuHubUnload then
		getgenv().KaijuHubUnload()
	end
end)
pcall(function()
	if getgenv and getgenv().KaijuHubCleanup then
		getgenv().KaijuHubCleanup()
	end
end)

-- Barre ventanas PealLib huérfanas de copias viejas (nombre de la librería).
-- OJO: va ANTES de cargar la librería, porque PealLib crea su ScreenGui
-- al cargarse; barrer después mataría la ventana nueva.
pcall(function()
	local containers = { game:GetService("CoreGui") }
	pcall(function()
		local h = gethui and gethui()
		if h then table.insert(containers, h) end
	end)
	pcall(function()
		local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
		if pg then table.insert(containers, pg) end
	end)
	for _, c in ipairs(containers) do
		pcall(function()
			for _, g in ipairs(c:GetChildren()) do
				if g:IsA("ScreenGui") and g.Name == "PealLibMain" then g:Destroy() end
			end
		end)
	end
end)

-- Load PealLib Library (fork de Linoria)
local repo = "https://raw.githubusercontent.com/pealz1/PealLib/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()

-- Managers de PealLib (temas + guardado de configs). Todo con pcall:
-- si el executor no tiene filesystem, el hub sigue funcionando sin configs.
local ThemeManager, SaveManager = nil, nil
pcall(function()
	ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
end)
pcall(function()
	SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()
end)
pcall(function()
	if ThemeManager then
		ThemeManager:SetLibrary(Library)
		ThemeManager:SetFolder("KaijuHub")
	end
end)
pcall(function()
	if SaveManager then
		SaveManager:SetLibrary(Library)
		SaveManager:IgnoreThemeSettings()
		SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
		SaveManager:SetFolder("KaijuHub/KaijuAlfa")
	end
end)

local function Notify(content, duration)
	pcall(function() Library:Notify(tostring(content), duration or 3) end)
	print("[Kaiju Hub] " .. tostring(content))
end

