-- Lee "Boss Spawn In\nMM:SS\n(presentes/requeridos)" -> secs, present, req
local function ReadBossTimer()
	local lbl = FindBossTimer()
	if not lbl then return nil end
	local txt = nil
	pcall(function() txt = lbl.Text end)
	if type(txt) ~= "string" then return nil end
	local m, s = txt:match("(%d+):(%d+)")
	local p, r = txt:match("%((%d+)/(%d+)%)")
	if not m then return nil end
	return tonumber(m) * 60 + tonumber(s), p and tonumber(p), r and tonumber(r)
end

-- Nombre limpio: "AI_Shin Eva Godzilla_1" -> "Shin Eva Godzilla"
local function BossPrettyName(b)
	local n = b.Name
	n = n:gsub("^AI_", "")
	n = n:gsub("_[%d]+$", "")
	n = n:gsub("_", " ")
	return n
end

local function BossTick()
	if State.Unloaded then return end
	local now = os.clock()
	if (now - (State.LastBossCheck or 0)) < 1 then return end
	State.LastBossCheck = now
	-- Display limpio: cuanto falta + cuántos hay (el extra ya viene en el contador)
	local secs, present, req = ReadBossTimer()
	if secs then
		pcall(function()
			if State.BossTimerLbl then
				State.BossTimerLbl:SetText(string.format("Falta: %d:%02d", math.floor(secs / 60), secs % 60))
			end
		end)
		pcall(function()
			if State.BossPlayersLbl then
				present = present or 0
				req = req or 3
				local extra = present >= req and " (listo)" or string.format(" (faltan %d)", req - present)
				State.BossPlayersLbl:SetText(string.format("En zona: %d/%d%s", present, req, extra))
			end
		end)
		local prev = State.LastBossSecs
		State.LastBossSecs = secs
		for _, mark in ipairs({ 60, 30, 10 }) do
			if prev and prev > mark and secs <= mark then
				Notify(string.format("Boss en %d segundos (%d/%d)", mark, present or 0, req or 3), 4)
			end
		end
	end
	local b = FindBoss()
	pcall(function()
		if State.BossStateLbl then
			if b then
				local h = b:FindFirstChildOfClass("Humanoid")
				State.BossStateLbl:SetText("Vida del jefe: " .. (h and tostring(math.floor(h.Health)) or "--"))
			else
				State.BossStateLbl:SetText("Vida del jefe: --")
			end
		end
	end)
	if b then
		pcall(function()
			if State.BossDmgLbl then
				local txt = "Daño causado: --"
				local ok, board = pcall(function() return b:GetAttribute("DamageBoard") end)
				if ok and type(board) == "string" and #board > 2 then
					local ok2, arr = pcall(HttpService.JSONDecode, HttpService, board)
					if ok2 and type(arr) == "table" then
						local total, mine = 0, 0
						for _, e in ipairs(arr) do
							local d = tonumber(e.d) or 0
							total = total + d
							if e.n == LocalPlayer.Name then mine = d end
						end
						if total > 0 then
							txt = string.format("Daño causado: %d (\"%.1f%%\")", math.floor(mine), mine / total * 100)
						end
					end
				end
				State.BossDmgLbl:SetText(txt)
			end
		end)
	end
	if b then
		if not State.BossActive then
			State.BossActive = true
			Notify("JEFE APARECIÓ: " .. BossPrettyName(b), 5)
		end
		State.LastBossSeenAt = now
	else
		State.BossActive = false
	end
end

-- ================= BOSS AUTOFARM + EVASOR =================
-- El jefe no avisa por atributos: sus ataques se ven como partes
-- Hitbox_<NombreJefe> en Debris (34³ lo normal, hasta 150³ los especiales).
-- Farm: pegado al jefe spameando Attack1. Evasor: al nacer su hitbox cerca
-- tuyo, sube +100 y vuelve (los especiales no llegan tan alto).
-- Pegado con WeldConstraint (no existe en la lista negra del Anti):
-- te sueldas detrás del jefe y la física te lleva con él, suave,
-- sin teleports a cada rato. Al girar él, sigues detrás.
local function UnweldBoss()
	pcall(function()
		if State.BossWeld then State.BossWeld:Destroy() end
	end)
	State.BossWeld = nil
end

local function WeldToBoss(myHRP, bHRP)
	UnweldBoss()
	local ok = pcall(function()
		local w = Instance.new("WeldConstraint")
		w.Name = "KaijuHubWeld"
		w.Part0 = myHRP
		w.Part1 = bHRP
		w.Parent = myHRP
	end)
	if ok then
		State.BossWeld = myHRP:FindFirstChild("KaijuHubWeld")
	end
end

local function BossHitboxName(boss)
	return boss and ("Hitbox_" .. boss.Name) or nil
end

local function OnBossHitbox(part)
	if State.Unloaded or not Config.BossFarm.Enabled or not Config.BossFarm.Dodge then return end
	if not part:IsA("BasePart") then return end
	local boss = FindBoss()
	if not boss or part.Name ~= BossHitboxName(boss) then return end
	if State.BossDodging then return end
	local myKaiju = GetMyKaiju(false)
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end
	local d
	pcall(function() d = (part.Position - myHRP.Position).Magnitude end)
	if not d or d > 100 then return end
	State.BossDodging = true
	UnweldBoss()
	task.spawn(function()
		local orig = myHRP.CFrame
		-- Escape según el TAMAÑO REAL de la hitbox (especiales de 150
		-- llegan a 75; melee de 34 con 60 sobra). Plataforma = sin caídas.
		local sz = 34
		pcall(function()
			sz = math.max(part.Size.X, part.Size.Y, part.Size.Z)
		end)
		local top = orig.Position + Vector3.new(0, math.max(60, sz / 2 + 40), 0)
		AcquireSkyPlatform(top)
		pcall(function()
			myHRP.CFrame = CFrame.new(Vector3.new(top.X, top.Y + 4, top.Z))
		end)
		-- Vuelve cuando LA HITBOX MUERE (+0.3s), no a tiempo fijo.
		-- Así no regresas en mitad del especial de 2s ni esperas de más.
		local t0 = os.clock()
		while os.clock() - t0 < 2.5 and not State.Unloaded do
			if not part.Parent then task.wait(0.3) break end
			task.wait(0.1)
		end
		pcall(function()
			if myHRP.Parent and not State.Unloaded then myHRP.CFrame = orig end
		end)
		ReleaseSkyPlatform()
		State.BossDodging = false
	end)
end

local function StartBossFarm()
	StopBossFarm()
	local map = Workspace:FindFirstChild("Map")
	local debris = map and map:FindFirstChild("Debris")
	if debris then
		table.insert(State.BossFarmConns, debris.DescendantAdded:Connect(OnBossHitbox))
	end
	local live = GetLiveFolder()
	if live then
		table.insert(State.BossFarmConns, live.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then OnBossHitbox(d) end
		end))
	end
	print("[BossFarm] Evasor activo")
end

function StopBossFarm()
	for _, c in ipairs(State.BossFarmConns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(State.BossFarmConns)
	State.BossDodging = false
	UnweldBoss()
end

-- Lee CDs y costos de TU kaiju actual (para rotar sin desperdiciar)
local function GetAttackStats()
	local stats = {}
	pcall(function()
		local myKaiju = GetMyKaiju(false)
		local kn = myKaiju and myKaiju:GetAttribute("KaijuName")
		if type(kn) ~= "string" or kn == "" then return end
		local kd = ReplicatedStorage:FindFirstChild("Shared")
		local km = kd and kd:FindFirstChild("KaijuData") and kd.KaijuData:FindFirstChild(kn)
		if not km then return end
		local ok, data = pcall(require, km)
		local st = ok and data and data.KaijuData and data.KaijuData.AttackStatics
		if not st then return end
		for _, a in ipairs({ "Attack1", "Attack2", "Attack3", "Attack4", "Attack5" }) do
			local s = st[a]
			if type(s) == "table" then
				stats[a] = {
					cd = type(s.Cooldown) == "number" and s.Cooldown or 3,
					en = type(s.Energy) == "number" and s.Energy or 0,
				}
			end
		end
	end)
	if not stats.Attack1 then stats.Attack1 = { cd = 3, en = 0 } end
	return stats
end

local function BossFarmTick()
	if not Config.BossFarm.Enabled or State.Unloaded or State.BossDodging then return end
	local now = os.clock()
	if (now - (State.LastBossFarmTick or 0)) < 0.25 then return end
	State.LastBossFarmTick = now
	local boss = FindBoss()
	if not boss then UnweldBoss() return end
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	local bHRP = boss:FindFirstChild("HumanoidRootPart")
	if not myKaiju or not myHRP or not bHRP then return end
	local wantDist = Config.BossFarm.StickDist or 12
	-- Punto detrás del jefe (sus cajas van adelante), a su altura
	local bLook = bHRP.CFrame.LookVector
	bLook = Vector3.new(bLook.X, 0, bLook.Z)
	if bLook.Magnitude < 0.001 then bLook = Vector3.new(0, 0, 1) end
	bLook = bLook.Unit
	local dest = Vector3.new(
		bHRP.Position.X - bLook.X * wantDist,
		bHRP.Position.Y,
		bHRP.Position.Z - bLook.Z * wantDist)
	local welded = State.BossWeld and State.BossWeld.Parent
	if not welded or (myHRP.Position - dest).Magnitude > wantDist + 8 then
		-- (Re)suelda: te coloca y quedas pegado, sin más saltos
		pcall(function()
			myHRP.CFrame = CFrame.lookAt(dest, bHRP.Position)
		end)
		WeldToBoss(myHRP, bHRP)
	end
	-- Rotación inteligente: dispara el primero listo (CD real + energía),
	-- en tu orden seleccionado. Sin desperdiciar en cooldown.
	if now >= (State.NextBossAttack or 0) then
		local stats = GetAttackStats()
		local en = myKaiju:GetAttribute("Energy") or 0
		local order = { "Attack1", "Attack2", "Attack3", "Attack4", "Attack5" }
		local fired = false
		for _, a in ipairs(order) do
			if Config.BossFarm.Attacks[a] then
				local s = stats[a] or stats.Attack1
				local readyAt = (State.BossCDs and State.BossCDs[a]) or 0
				if now >= readyAt and en >= (s.en or 0) then
					FireSkill(a)
					State.BossCDs = State.BossCDs or {}
					State.BossCDs[a] = now + (s.cd or 3)
					State.NextBossAttack = now + 0.5
					fired = true
					break
				end
			end
		end
		if not fired then
			State.NextBossAttack = now + 0.5
		end
	end
end

-- ================= QUEST FARM TICK =================
local function QuestFarmTick()
	if not Config.QuestFarm or not Config.QuestFarm.Enabled or State.Unloaded then return end
	local now = os.clock()
	if (now - (State.QuestLastCheck or 0)) < 2 then return end
	State.QuestLastCheck = now
	
	-- Auto-claim completed quests
	local available = GetAvailableQuests()
	for _, aq in pairs(available) do
		if aq.ReadyToClaim then
			local ok = ClaimQuest(aq.Type, aq.Quest.Id)
			if ok then
				Notify("Claimed " .. aq.Type .. " quest: " .. aq.Quest.Info, 3)
			end
		end
	end
	
	-- Select and track best quest
	if Config.QuestFarm.AutoSelect then
		local best = SelectBestQuest()
		if best then
			State.QuestCurrentId = best.Quest.Id
			State.QuestCurrentType = best.Type
			-- Track progress for stuck detection
			local prog = best.Quest.Goal > 0 and (best.Quest.Progress / best.Quest.Goal) or 0
			if prog <= (State.QuestLastProgress or 0) + 0.001 then
				State.QuestStuckCount = (State.QuestStuckCount or 0) + 1
			else
				State.QuestStuckCount = 0
			end
			State.QuestLastProgress = prog
			
			-- If stuck for too long, try next quest (degrade)
			if State.QuestStuckCount > 5 and Config.QuestFarm.DegradeStuck then
				State.QuestStuckCount = 0
				-- Could implement quest skip logic here
			end
		else
			State.QuestCurrentId = nil
			State.QuestCurrentType = nil
		end
	end
end

-- ================= FARM KAIJU TICK =================
local function FarmKaijuTick()
	if not Config.FarmKaijus or not Config.FarmKaijus.Enabled or State.Unloaded then return end
	if not Config.FarmKaijus.Target or Config.FarmKaijus.Target == "" then return end
	
	local now = os.clock()
	if (now - (State.FarmKaijuLastAction or 0)) < 3 then return end
	
	local stages = GetFarmKaijuStages(Config.FarmKaijus.Target)
	if #stages == 0 then
		Config.FarmKaijus.Enabled = false
		Notify("FarmKaijus: No stages for " .. Config.FarmKaijus.Target, 3)
		return
	end
	
	-- Find current stage
	local currentStage = nil
	for i, stage in ipairs(stages) do
		local met, msg = stage.Check()
		if not met then
			currentStage = stage
			State.FarmKaijuStage = i
			break
		end
	end
	
	if not currentStage then
		-- All stages complete!
		Config.FarmKaijus.Enabled = false
		Notify("FarmKaijus: " .. Config.FarmKaijus.Target .. " acquired!", 5)
		return
	end
	
	-- Execute current stage action
	if currentStage.Type == "Requirement" then
		-- For requirements, we need to farm the prerequisite kaiju
		-- This could trigger auto-farm or quest farm for the req kaiju
		local reqName = currentStage.Name
		local reqData = currentStage.Data
		local met, msg = currentStage.Check()
		if not met then
			-- Update progress label
			if Config.FarmKaijus.ProgressLabel then
				Config.FarmKaijus.ProgressLabel:SetText("Progress: Farming " .. reqName .. " (" .. msg .. ")")
			end
			if Config.FarmKaijus.ReqLabel then
				Config.FarmKaijus.ReqLabel:SetText("Current Requirement: " .. reqName .. " - " .. msg)
			end
			if Config.FarmKaijus.StatusLabel then
				Config.FarmKaijus.StatusLabel:SetText("Status: Working on requirement")
			end
			
			-- Auto-enable quest farm for requirement if not already
			if Config.QuestFarm and not Config.QuestFarm.Enabled then
				Config.QuestFarm.Enabled = true
				Config.QuestFarm.AutoSelect = true
				Notify("Auto-enabling Quest Farm for " .. reqName, 3)
			end
		end
	elseif currentStage.Type == "Purchase" then
		-- Purchase the target kaiju
		if Config.FarmKaijus.ProgressLabel then
			Config.FarmKaijus.ProgressLabel:SetText("Progress: Purchasing " .. currentStage.Name .. "...")
		end
		if Config.FarmKaijus.ReqLabel then
			Config.FarmKaijus.ReqLabel:SetText("Current Requirement: Purchase " .. currentStage.Name)
		end
		if Config.FarmKaijus.StatusLabel then
			Config.FarmKaijus.StatusLabel:SetText("Status: Buying...")
		end
		
		local ok, msg = PurchaseKaiju(currentStage.Name)
		if ok then
			Notify("Purchased " .. currentStage.Name .. "!", 5)
			State.FarmKaijuErrorCount = 0
		else
			State.FarmKaijuErrorCount = (State.FarmKaijuErrorCount or 0) + 1
			Notify("Purchase failed: " .. msg, 3)
			if State.FarmKaijuErrorCount > 3 then
				Config.FarmKaijus.Enabled = false
				Notify("FarmKaijus: Too many purchase errors, stopping", 3)
			end
		end
		State.FarmKaijuLastAction = now
	end
end

-- ================= MAIN LOOP =================
local function OnRenderStep()
	if State.Unloaded then return end
	UpdateFOVCircle()
	-- ESP throttled a ~4Hz para no matar FPS
	local now = os.clock()
	if Config.ESP.Enabled and (now - State.LastESPUpdate) > 0.25 then
		State.LastESPUpdate = now
		pcall(UpdateESP)
	end
	if Config.Movement.Enabled then
		pcall(UpdateMovement)
	end
	if Config.Kill.Enabled then
		pcall(KillTick)
	end
	pcall(VoteTick)
	pcall(BossTick)
	if Config.BossFarm.Enabled then
		pcall(BossFarmTick)
	end
	pcall(RespawnTick)
	if Config.Farm.Builds or Config.Farm.Players then
		pcall(FarmTick)
	end
	if Config.Farm.AutoFarm then
		pcall(AutoFarmTick)
	end
	if Config.Farm.BeamAlto then
		pcall(BeamAltoTick)
	end
	-- New systems
	if Config.QuestFarm and Config.QuestFarm.Enabled then
		pcall(QuestFarmTick)
	end
	if Config.FarmKaijus and Config.FarmKaijus.Enabled then
		pcall(FarmKaijuTick)
	end
end

