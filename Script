-- Asegura jugar como X (selecciona + spawnea). Devuelve true si ya estás.
-- El equip tarda en replicar: tras Select espera a que CurrentKaiju == X
-- (máx 6s) antes de pulsar Spawn. Sin esta espera spawneas con el anterior.
local function EnsureKaiju(name)
	if not name or name == "" or name:lower():find("any kaiju") then return true end
	local myKaiju = GetMyKaiju(false)
	local cur = myKaiju and myKaiju:GetAttribute("KaijuName")
	if cur == name then
		local hum = myKaiju:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then return true end
	end
	if State.EnsureKaiju == name and (os.clock() - (State.EnsureAt or 0)) < 15 then
		return false -- esperando spawn, no spamear
	end
	State.EnsureKaiju = name
	State.EnsureAt = os.clock()
	if SelectKaiju(name) then
		-- Generación: si apagas el quest, este hilo muere solo (si no,
		-- te mata/respawnea mucho después de apagar y parece "bugeado").
		State.EnsureGen = (State.EnsureGen or 0) + 1
		local gen = State.EnsureGen
		local function alive()
			return not State.Unloaded and Config.Quests.Auto
				and State.EnsureGen == gen and State.EnsureKaiju == name
		end
		task.spawn(function()
			-- 1) Espera a que el servidor equipe (CurrentKaiju == name).
			local t0 = os.clock()
			while alive() and (os.clock() - t0) < 4 do
				if GetEquippedKaiju() == name then break end
				task.wait(0.25)
			end
			if not alive() then return end
			-- 2) El Spawn en vivo se ignora: hay que morir primero.
			local t1 = os.clock()
			while alive() and (os.clock() - t1) < 6 do
				local mk = GetMyKaiju(false)
				local hum = mk and mk:FindFirstChildOfClass("Humanoid")
				if not mk or not hum or hum.Health <= 0 then break end
				if (os.clock() - (State.EnsureDeathAt or 0)) > 4 then
					State.EnsureDeathAt = os.clock()
					pcall(function()
						local cr = GetCombatRemote()
						if cr then cr:FireServer("Death") end
					end)
				end
				task.wait(0.25)
			end
			-- 3) Spawnea hasta aparecer con el nuevo (reintenta).
			local t2 = os.clock()
			while alive() and (os.clock() - t2) < 10 do
				local mk = GetMyKaiju(false)
				if mk and mk:GetAttribute("KaijuName") == name then break end
				PressSpawn()
				task.wait(1)
			end
		end)
	end
	return false
end

-- Enciende/apaga sistemas EXISTENTES de forma exclusiva (un solo job
-- activo). Solo apaga lo que el propio quest encendió (QuestDrove*), así
-- tu config manual nunca se pisa.
local function QuestSystems(want)
	want = want or {}
	if want.boss and not Config.BossFarm.Enabled then
		Config.BossFarm.Enabled = true
		State.QuestDroveBossFarm = true
		pcall(function() local t = Tgl("BossFarmOn") if t then t:SetValue(true) end end)
	elseif not want.boss and Config.BossFarm.Enabled and State.QuestDroveBossFarm then
		Config.BossFarm.Enabled = false
		State.QuestDroveBossFarm = false
		pcall(function() local t = Tgl("BossFarmOn") if t then t:SetValue(false) end end)
	end
	if want.beam then
		if not Config.Farm.Builds then
			Config.Farm.Builds = true
			State.QuestDroveBuilds = true
			pcall(function() local t = Tgl("FarmBuilds") if t then t:SetValue(true) end end)
		end
		if not Config.Farm.AutoFarm then
			Config.Farm.AutoFarm = true
			State.QuestDroveAutoFarm = true
			pcall(function() local t = Tgl("AutoFarm") if t then t:SetValue(true) end end)
		end
	else
		State.QuestSkyTop = nil
		if Config.Farm.Builds and State.QuestDroveBuilds then
			Config.Farm.Builds = false
			State.QuestDroveBuilds = false
			pcall(function() local t = Tgl("FarmBuilds") if t then t:SetValue(false) end end)
		end
		if Config.Farm.AutoFarm and State.QuestDroveAutoFarm and not want.autofarm then
			Config.Farm.AutoFarm = false
			State.QuestDroveAutoFarm = false
			pcall(function() local t = Tgl("AutoFarm") if t then t:SetValue(false) end end)
		end
	end
	if want.autofarm and not Config.Farm.AutoFarm then
		Config.Farm.AutoFarm = true
		State.QuestDroveAutoFarm = true
		pcall(function() local t = Tgl("AutoFarm") if t then t:SetValue(true) end end)
	end
	if want.players and not Config.Farm.Players then
		Config.Farm.Players = true
		State.QuestDrovePlayers = true
		pcall(function() local t = Tgl("FarmPlayers") if t then t:SetValue(true) end end)
	elseif not want.players and Config.Farm.Players and State.QuestDrovePlayers then
		Config.Farm.Players = false
		State.QuestDrovePlayers = false
		pcall(function() local t = Tgl("FarmPlayers") if t then t:SetValue(false) end end)
	end
	if want.kill and not Config.Kill.Enabled then
		Config.Kill.Enabled = true
		State.QuestDroveKill = true
		pcall(function() local t = Tgl("KillEnabled") if t then t:SetValue(true) end end)
	elseif not want.kill and Config.Kill.Enabled and State.QuestDroveKill then
		Config.Kill.Enabled = false
		Config.Kill.Targets = {}
		pcall(function() local t = Tgl("KillTargets") if t then t:SetValue({}) end end)
		State.QuestDroveKill = false
		State.KillNoclipModel = nil
		pcall(SetGhostNoclip, false)
		pcall(function() local t = Tgl("KillEnabled") if t then t:SetValue(false) end end)
	end
end

-- Orquestador SECUENCIAL de misiones (cada 10s): elige UNA misión
-- accionable por prioridad (boss > kills > beam > jugar-con-X > pasivas),
-- la hace con los sistemas existentes (BossFarmTick, AutoFarmTick, KillTick)
-- y al terminar pasa a la siguiente. Al completar las 10 resetea y sigue
-- con las 10 nuevas. No crea combate propio.
local function QuestTick()
	if not Config.Quests.Auto or State.Unloaded then return end
	local now = os.clock()
	if (now - (State.LastQuestTick or 0)) < 5 then return end
	State.LastQuestTick = now
	State.QuestBeamOnly = false
	local quests, meta = FetchQuests()
	-- Primero reclama lo completado (ciclo: hacer -> reclamar -> reset)
	pcall(ClaimQuestsAll)
	local owned = OwnedKaijuSet()
	local lines, impossible = {}, {}
	local acted = false
	local bossWaiting = false
	local killWaiting = false
	local bossRuleIgnored = false

	local todo = {}
	for _, q in ipairs(quests) do
		if not q.Done and not q.Locked then table.insert(todo, q) end
	end

	-- Kaiju actual (para saber si hay que cambiar antes del job).
	local curKaiju = nil
	pcall(function()
		local mk = GetMyKaiju(false)
		curKaiju = mk and mk:GetAttribute("KaijuName") or nil
	end)
	-- Misiones estancadas: se saltan 10 min y reintentan (no atascan el
	-- 1x1). Mientras saltadas cuentan como imposibles para el reset.
	State.QuestStallSkip = State.QuestStallSkip or {}
	local nowStall = os.clock()
	for sk, ts in pairs(State.QuestStallSkip) do
		if (nowStall - (tonumber(ts) or 0)) > 600 then
			State.QuestStallSkip[sk] = nil
		end
	end

	-- ===== MODO SECUENCIAL ESTRICTO: 1 misión a la vez =====
	-- Prioridad: 1 boss (activo/espera) > 2 kills > 3 beam > 4 jugar-con-X
	-- > 5 pasivas. El job se mantiene hasta CONFIRMAR Done+claim; solo
	-- entonces pasa al siguiente. Sin rotaciones por tiempo: una por una.
	local cands = {} -- {rank, idx, kind, q, need, carrier, secs, key}
	for _, q in ipairs(todo) do
		local qkey = q.Group .. "." .. q.Key
		if State.QuestStallSkip[qkey] then
			table.insert(impossible, q.Info:sub(1, 45) .. " (estancada)")
		else
			local kind, need = ClassifyQuest(q.Info, owned)
		if kind == "IMPOSSIBLE" then
			table.insert(impossible, q.Info:sub(1, 45))
		elseif kind == "SKIP_BOSS" then
			table.insert(lines, "Ignorada (NoBoss): " .. q.Info:sub(1, 40))
		elseif kind == "SKIP_PLAYER" then
			table.insert(lines, "Ignorada (NoPlayerKills): " .. q.Info:sub(1, 40))
		elseif kind == "BOSS" then
			local boss = FindBoss()
			if boss then
				-- REGLA sala de espera (toggle "Solo si esperé"): si inició
				-- sin ti, no cuenta. Apagado = se farmea igual.
				if State.BossStartedWithMe == false and Config.BossFarm.WaitOnly ~= false then
					bossRuleIgnored = true
					table.insert(lines, "BOSS inició sin ti (no cuenta)")
				else
					table.insert(cands, { rank = 1, idx = #cands + 1, kind = "BOSS", q = q, need = need })
				end
			else
				-- Sin boss: solo se espera en sala si falta <5 min y hay
				-- quorum (3/3 o más). Si no, se sigue con otras misiones.
				local secs, present, req = ReadBossTimer()
				if secs and secs < 300 and (present or 0) >= (req or 3) then
					table.insert(cands, { rank = 1, idx = #cands + 1, kind = "BOSS_WAIT", q = q, need = need, secs = secs })
				else
					bossWaiting = true
					if secs then
						table.insert(lines, "BOSS en " .. string.format("%d:%02d", math.floor(secs / 60), secs % 60)
							.. " (" .. tostring(present or 0) .. "/" .. tostring(req or 3) .. ", esperando)")
					else
						table.insert(lines, "BOSS ausente (esperando spawn): " .. q.Info:sub(1, 35))
					end
				end
			end
		elseif kind == "BEAM_BUILD" then
			if need and not owned[need] then
				table.insert(impossible, q.Info:sub(1, 45) .. " (sin " .. need .. ")")
			elseif need and not HasBeamKaiju(need) then
				-- Pide beam con un kaiju sin beam: imposible de origen.
				table.insert(impossible, q.Info:sub(1, 45) .. " (sin beam: " .. need .. ")")
			else
				table.insert(cands, { rank = 3, idx = #cands + 1, kind = "BEAM_BUILD", q = q, need = need })
			end
		elseif kind == "DESTROY_BUILD" then
			if need and not owned[need] then
				table.insert(impossible, q.Info:sub(1, 45) .. " (sin " .. need .. ")")
			else
				table.insert(cands, { rank = 3, idx = #cands + 1, kind = "DESTROY_BUILD", q = q, need = need })
			end
		elseif kind == "PLAY_AS" then
			table.insert(cands, { rank = 4, idx = #cands + 1, kind = "PLAY_AS", q = q, need = need })
		elseif kind == "SWIM" then
			table.insert(cands, { rank = 4, idx = #cands + 1, kind = "SWIM", q = q, need = need })
		elseif kind == "FLY" then
			local flyer = need
			if flyer and not owned[flyer] then
				table.insert(impossible, q.Info:sub(1, 45) .. " (sin " .. flyer .. ")")
			else
				if not flyer then
					-- Genérica: primer poseído que vuele (para el cambio).
					local fl = {}
					for name in pairs(owned) do table.insert(fl, name) end
					table.sort(fl)
					for _, name in ipairs(fl) do
						if HasFlyKaiju(name) then flyer = name break end
					end
				end
				if flyer and not HasFlyKaiju(flyer) then
					table.insert(impossible, q.Info:sub(1, 45) .. " (no vuela)")
				elseif flyer then
					table.insert(cands, { rank = 4, idx = #cands + 1, kind = "FLY", q = q, need = flyer })
				else
					table.insert(impossible, q.Info:sub(1, 45) .. " (sin volador)")
				end
			end
		elseif kind == "KILL_NAMED" then
			local needKaiju = UsingRequirement(q.Info, owned)
			local carrier = nil
			for _, enemy in ipairs(GetEnemyKaijus()) do
				if enemy:GetAttribute("KaijuName") == need then carrier = enemy break end
			end
			if carrier then
				-- Sin kaiju exigido: DFF + beam a jugadores (si se posee).
				-- Con exigencia: KillTick pegado con ese kaiju.
				local useBeam = (not needKaiju) and owned["Destoroyah Final Form"] == true
				table.insert(cands, { rank = 2, idx = #cands + 1, kind = "KILL_NAMED", q = q,
					need = useBeam and "Destoroyah Final Form" or needKaiju, target = need, carrier = carrier, beam = useBeam })
			else
				table.insert(impossible, q.Info:sub(1, 45) .. " (ausente)")
			end
		elseif kind == "KILL_ANY" then
			if #GetEnemyKaijus() > 0 then
				-- Genérica: DFF + beam a jugadores (si se posee); si no, KillTick.
				local useBeam = owned["Destoroyah Final Form"] == true
				table.insert(cands, { rank = 2, idx = #cands + 1, kind = "KILL_ANY", q = q,
					need = useBeam and "Destoroyah Final Form" or nil, beam = useBeam })
			else
				killWaiting = true
				table.insert(lines, "Sin jugadores en el server (esperando)")
			end
		else
			table.insert(cands, { rank = 5, idx = #cands + 1, kind = "PASSIVE", q = q })
			end
		end
	end
	table.sort(cands, function(a, b)
		if a.rank ~= b.rank then return a.rank < b.rank end
		return a.idx < b.idx
	end)
	-- Job = mejor candidata. Sin rotaciones: se mantiene hasta confirmar
	-- Done+claim (sale sola del todo). El cambio de kaiju lo pide el job.
	local job = cands[1]
	-- El job manda su kaiju: si pide otro, cambiar es el job de este tick.
	local switchNeed = nil
	if job and job.need and job.need ~= curKaiju then
		switchNeed = job.need
		EnsureKaiju(switchNeed)
	end
	-- Estado de cola para las no elegidas con kaiju pendiente.
	if switchNeed or (job and job.need and job.need == curKaiju) then
		for _, c in ipairs(cands) do
			if c ~= job and c.need and c.need ~= curKaiju and c.need ~= switchNeed then
				table.insert(lines, "En cola: " .. c.need)
				break -- una línea basta
			end
		end
	end
	-- 2) Ejecutar el job (uno solo) + líneas de estado.
	local groundActive = false
	local moveActive = false
	if switchNeed then
		acted = true
		table.insert(lines, 1, "▶ Cambiando a " .. switchNeed .. "...")
	elseif job then
		acted = true
		if job.kind == "BOSS" then
			QuestSystems({ boss = true })
			table.insert(lines, 1, "▶ BOSS ACTIVO: " .. job.q.Info:sub(1, 45)
				.. " (" .. job.q.Progress .. "/" .. job.q.Goal .. ")")
		elseif job.kind == "BOSS_WAIT" then
			QuestSystems({ boss = true })
			bossWaiting = true
			local far = true
			pcall(function()
				local mk = GetMyKaiju(false)
				local hrp = mk and mk:FindFirstChild("HumanoidRootPart")
				if hrp then far = (hrp.Position - BOSS_PORTAL).Magnitude > 120 end
			end)
			if far then GoBossPortal() end
			table.insert(lines, 1, "▶ BOSS en sala, esperando (" .. tostring(job.secs) .. "s)")
		elseif job.kind == "BEAM_BUILD" then
			QuestSystems({ beam = true })
			State.QuestBeamOnly = true
			State.KillNoclipModel = nil
			State.GroundNoclipModel = nil
			pcall(SetGhostNoclip, false)
			if not Config.Farm.Builds then
				Config.Farm.Builds = true
				pcall(function() local t = Tgl("FarmBuilds") if t then t:SetValue(true) end end)
			end
			InstallSilentHooks()
			-- Reutiliza AutoFarmTick: centro de edificios + plataforma
			-- invisible + disparo con CD real. Sin teleports por frame
			-- (TeleportToBuildCenter solo actúa si estás lejos).
			TeleportToBuildCenter()
			State.QuestSkyTop = BUILD_CENTER + Vector3.new(0, BUILD_HOVER_H, 0)
			table.insert(lines, 1, "▶ Beam builds: " .. job.q.Progress .. "/" .. job.q.Goal .. " (Tokyo centro)")
		elseif job.kind == "DESTROY_BUILD" then
			-- Destruir SIN beam exigido: SIEMPRE a pie entre edificios con
			-- ataques normales (estas misiones suelen pedir kaijus sin beam).
			-- No toca "Beam a edificios": modo suelo con lista propia.
			QuestSystems({})
			QuestGroundSet(true)
			groundActive = true
			table.insert(lines, 1, "▶ Destruyendo (suelo, " .. (job.need or curKaiju or "?") .. "): " .. job.q.Progress .. "/" .. job.q.Goal)
		elseif job.kind == "PLAY_AS" then
			QuestSystems({})
			table.insert(lines, 1, "▶ Jugando " .. job.need .. ": " .. job.q.Progress .. "/" .. job.q.Goal)
		elseif job.kind == "SWIM" then
			QuestSystems({})
			if job.need and not owned[job.need] then
				table.insert(lines, 1, "▶ Nadar imposible (sin " .. job.need .. ")")
			else
				State.QuestMove = { kind = "swim", center = SWIM_SPOT, range = 150 }
				moveActive = true
				table.insert(lines, 1, "▶ Nadando: " .. job.q.Progress .. "/" .. job.q.Goal
					.. (job.need and (" (" .. job.need .. ")") or ""))
			end
		elseif job.kind == "FLY" then
			QuestSystems({})
			if not HasFlyKaiju(job.need) then
				table.insert(lines, 1, "▶ " .. tostring(job.need) .. " no vuela (imposible)")
				table.insert(impossible, job.q.Info:sub(1, 45) .. " (no vuela)")
			else
				State.QuestMove = { kind = "fly", center = FLY_SPOT, range = 150 }
				moveActive = true
				table.insert(lines, 1, "▶ Volando (" .. job.need .. "): " .. job.q.Progress .. "/" .. job.q.Goal)
			end
		elseif (job.kind == "KILL_NAMED" or job.kind == "KILL_ANY") and job.beam then
			-- Sin kaiju exigido: DFF + beam a jugadores (rotando) + autofarm.
			-- Plataforma FIJA sobre Tokyo + CON colisión y quieto: en
			-- freefall/sin apoyo el servidor rechaza los skills.
			QuestSystems({ players = true, autofarm = true })
			InstallSilentHooks()
			State.KillNoclipModel = nil
			State.GroundNoclipModel = nil
			pcall(SetGhostNoclip, false)
			pcall(function()
				local mk = GetMyKaiju(false)
				local hrp = mk and mk:FindFirstChild("HumanoidRootPart")
				if hrp and (hrp.Position - TOKYO_FARM_TOP).Magnitude > 100 then
					hrp.CFrame = CFrame.new(TOKYO_FARM_TOP)
				end
			end)
			State.QuestSkyTop = TOKYO_FARM_TOP
			table.insert(lines, 1, "▶ Beam jugadores (DFF): " .. job.q.Progress .. "/" .. job.q.Goal)
		elseif job.kind == "KILL_NAMED" then
			-- Con kaiju exigido: melee con KillTick.
			QuestSystems({ kill = true })
			pcall(function()
				Config.Kill.Targets = { [job.carrier.Name] = true }
				local t = Tgl("KillTargets")
				if t then t:SetValue({ [job.carrier.Name] = true }) end
			end)
			table.insert(lines, 1, "▶ A por " .. tostring(job.target or job.need) .. " (" .. job.carrier.Name .. "): "
				.. job.q.Progress .. "/" .. job.q.Goal)
		elseif job.kind == "KILL_ANY" then
			-- Sin DFF poseído: melee a todos con KillTick.
			QuestSystems({ kill = true })
			if next(Config.Kill.Targets) then
				Config.Kill.Targets = {}
				pcall(function() local t = Tgl("KillTargets") if t then t:SetValue({}) end end)
			end
			table.insert(lines, 1, "▶ Kills: " .. job.q.Progress .. "/" .. job.q.Goal .. " (auto kill)")
		else -- PASSIVE
			QuestSystems({})
			table.insert(lines, 1, "▶ Pasiva: " .. job.q.Info:sub(1, 50)
				.. " (" .. job.q.Progress .. "/" .. job.q.Goal .. ")")
		end
	else
		QuestSystems({})
	end
	-- Suelo/movimiento solo durante su job; al salir se apagan.
	if State.QuestGround and not groundActive then
		QuestGroundSet(false)
	end
	if State.QuestMove and not moveActive then
		State.QuestMove = nil
	end
	-- Vigilante de estancamiento: si el MISMO job lleva 120 ticks (~10 min
	-- a 5s) con el MISMO progreso, se salta 10 min y reintenta (los kills
	-- son lentos: 2 min sin progreso es normal). No aplica a BOSS_WAIT.
	if job and job.q and job.kind ~= "BOSS_WAIT" then
		local jkey = job.q.Group .. "." .. job.q.Key
		local jprog = job.q.Progress
		local st = State.QuestStall or {}
		if st.key == jkey and st.prog == jprog then
			st.n = (st.n or 0) + 1
			if st.n >= 120 and not State.QuestStallSkip[jkey] then
				State.QuestStallSkip[jkey] = now
				Notify("Misión estancada 10 min, pasando a la siguiente (reintenta en 10 min)", 5)
			end
		else
			st = { key = jkey, prog = jprog, n = 0 }
		end
		State.QuestStall = st
	else
		State.QuestStall = nil
	end
	-- Estado del resto (detección visible de las 10).
	for _, c in ipairs(cands) do
		if not job or c.q ~= job.q then
			local tag = c.q.Progress .. "/" .. c.q.Goal
			if c.kind == "BOSS" or c.kind == "BOSS_WAIT" then
				table.insert(lines, "○ Boss: " .. c.q.Info:sub(1, 38) .. " [" .. tag .. "]")
			elseif c.kind == "BEAM_BUILD" then
				table.insert(lines, "○ Beam: " .. c.q.Info:sub(1, 38) .. " [" .. tag .. "]")
			elseif c.kind == "DESTROY_BUILD" then
				table.insert(lines, "○ Edificios: " .. c.q.Info:sub(1, 33) .. " [" .. tag .. "]")
			elseif c.kind == "PLAY_AS" then
				table.insert(lines, "○ Jugar: " .. c.q.Info:sub(1, 38) .. " [" .. tag .. "]")
			elseif c.kind == "SWIM" then
				table.insert(lines, "○ Nadar: " .. c.q.Info:sub(1, 38) .. " [" .. tag .. "]")
			elseif c.kind == "FLY" then
				table.insert(lines, "○ Volar: " .. c.q.Info:sub(1, 38) .. " [" .. tag .. "]")
			elseif c.kind == "KILL_NAMED" then
				table.insert(lines, "○ Matar: " .. c.q.Info:sub(1, 38) .. " [" .. tag .. "]")
			elseif c.kind == "KILL_ANY" then
				table.insert(lines, "○ Kills [" .. tag .. "]")
			else
				table.insert(lines, "○ Pasiva: " .. c.q.Info:sub(1, 38) .. " [" .. tag .. "]")
			end
		end
	end

	-- Reset y ciclo: al completar las 10 (todo vacío) resetea para seguir
	-- con las 10 nuevas. También resetea si solo quedan imposibles
	-- (ej. matar un kaiju ausente). La espera de boss/jugadores y la regla
	-- de sala NO disparan reset: pueden resolverse solas.
	local function DoReset(reason)
		local resets = tonumber(meta.ResetsLeft) or 0
		if resets <= 0 then return false end
		local ok = pcall(function()
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local qr = remotes and remotes:FindFirstChild("InvokeQuest")
			if qr then qr:InvokeServer("ResetQuests", "Cells") end
		end)
		if ok then
			State.QuestFocus = nil
			State.QuestFocusTicks = 0
			State.QuestLastFocus = nil
			State.QuestStallSkip = {}
			State.QuestStall = nil
			State.QuestWaitStall = 0
			State.GroundDead = {}
			State.GroundBuildings = {}
			State.LastGroundScan = 0
			Notify(reason, 5)
			return true
		end
		return false
	end
	-- Espera atascada: si llevas ~3 min (36 ticks) sin nada accionable
	-- porque solo queda espera de boss/jugadores, se permite resetear
	-- para no dejar el AFK colgado eternamente.
	if not acted and (bossWaiting or killWaiting) then
		State.QuestWaitStall = (State.QuestWaitStall or 0) + 1
	else
		State.QuestWaitStall = 0
	end
	local waitStuck = (State.QuestWaitStall or 0) >= 36
	if #todo == 0 then
		if Config.Quests.AutoReset then
			if not DoReset("Ciclo completo: 10/10 listas, reseteando...") then
				table.insert(lines, 1, "Ciclo completo (sin resets)")
			end
		else
			table.insert(lines, 1, "Ciclo completo: las 10 listas")
		end
	elseif not acted and not bossRuleIgnored and Config.Quests.AutoReset
		and ((not bossWaiting and not killWaiting) or waitStuck) then
		if not DoReset("Sin nada hacible: misiones reseteadas (" .. #impossible .. " imposibles)"
			.. (waitStuck and " [espera 3min]" or "")) then
			if #impossible > 0 then
				table.insert(lines, 1, "Imposibles (" .. #impossible .. ", sin resets)")
			end
		end
	elseif #impossible > 0 and not acted then
		table.insert(lines, 1, "Imposibles (" .. #impossible .. ")")
	end
	if #impossible > 0 and (acted or bossWaiting) then
		table.insert(lines, "Imposibles en espera: " .. #impossible)
	end
	if bossRuleIgnored and not acted then
		table.insert(lines, 1, "Boss inició sin ti (no cuenta, esperando próximo)")
	end
	if not acted and not bossRuleIgnored then table.insert(lines, 1, "Nada accionable (boss ausente?)") end
	State.QuestPlan = table.concat(lines, "\n")
	pcall(function()
		if State.QuestLbl then State.QuestLbl:SetText(State.QuestPlan:sub(1, 900)) end
	end)
end



-- ================= MAIN LOOP =================
local function OnRenderStep()
	if State.Unloaded then return end
	UpdateFOVCircle()
	-- ESP throttled a ~4Hz para no matar FPS
	local now = os.clock()
	if Config.ESP.Enabled and (now - State.LastESPUpdate) > 0.25 then
		State.LastESPUpdate = now
		pcall(UpdateESP)
	end
	if Config.Movement.Enabled then
		pcall(UpdateMovement)
	end
	if Config.Kill.Enabled then
		pcall(KillTick)
	end
	pcall(VoteTick)
	pcall(BossTick)
	if Config.Quests.Auto then
		local ok, err = pcall(QuestTick)
		if not ok then
			if (os.clock() - (State.LastQuestErrWarn or 0)) > 30 then
				State.LastQuestErrWarn = os.clock()
				warn("[Kaiju Hub] QuestTick falló: " .. tostring(err))
			end
		end
	end
	if Config.BossFarm.Enabled then
		pcall(BossFarmTick)
	end
	pcall(RespawnTick)
	if Config.Farm.Builds or Config.Farm.Players then
		pcall(FarmTick)
	end
	if Config.Farm.AutoFarm then
		pcall(AutoFarmTick)
	end
	if State.QuestGround or Config.QuestGround.Enabled then
		pcall(QuestGroundTick)
	end
	if State.QuestMove then
		pcall(QuestMoveTick)
	end
	if Config.Reclaim.BP or Config.Reclaim.Quests or Config.Reclaim.Codes then
		pcall(ReclaimTick)
	end
end

-- ================= CLEANUP =================
local function Cleanup()
	State.Unloaded = true
	DestroyFOVCircle()
	ClearAllESP()
	pcall(RestoreMovement)
	pcall(RemoveSilentHooks)
	pcall(StopBossFarm)
	State.KillNoclipModel = nil
	State.GroundNoclipModel = nil
	pcall(SetGhostNoclip, false)
	pcall(function()
		local mk = GetMyKaiju(false)
		local hrp = mk and mk:FindFirstChild("HumanoidRootPart")
		if hrp then hrp.Anchored = false end
	end)
	pcall(DestroySkyPlatform)
	State.QuestSkyTop = nil
	State.QuestGround = false
	State.QuestBeamOnly = false
	-- Limpiar conexiones locales
	for _, conn in ipairs(State.Connections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(State.Connections)
	-- Limpiar registro global de conexiones (de esta y otras ejecuciones)
	if getgenv().KaijuHubConnections then
		for _, conn in ipairs(getgenv().KaijuHubConnections) do
			pcall(function() conn:Disconnect() end)
		end
		table.clear(getgenv().KaijuHubConnections)
	end
end

-- Descarga TOTAL de esta copia: loops, hooks, velocidad, ESP, FOV y ventana
local function FullUnload()
	pcall(Cleanup)
	pcall(function() Library:Unload() end)
	pcall(function()
		if getgenv and getgenv().KaijuHubUnload then
			getgenv().KaijuHubUnload = nil
		end
	end)
end

