local function GetOwnedKaijus()
	local dataFolder = GetPlayerDataFolder()
	if not dataFolder then return {} end
	local inv = dataFolder:FindFirstChild("KaijuInventory")
	if not inv then return {} end
	local owned = {}
	for _, kaiju in pairs(inv:GetChildren()) do
		local level = kaiju:FindFirstChild("Level")
		local kills = kaiju:FindFirstChild("Kills")
		local exp = kaiju:FindFirstChild("Exp")
		local fav = kaiju:FindFirstChild("Favourite")
		owned[kaiju.Name] = {
			Level = level and level.Value or 1,
			Kills = kills and kills.Value or 0,
			Exp = exp and exp.Value or 0,
			Favourite = fav and fav.Value or false,
			MaxLevel = kaiju:FindFirstChild("MaxLevel") and kaiju.MaxLevel.Value or 100,
			LimitBreak = kaiju:FindFirstChild("LimitBreak") and kaiju.LimitBreak.Value or false,
		}
	end
	return owned
end

local function GetCurrency()
	local dataFolder = GetPlayerDataFolder()
	if not dataFolder then return { Cells = 0, Gems = 0 } end
	local cells = dataFolder:FindFirstChild("Cells")
	local gems = dataFolder:FindFirstChild("Gems")
	return {
		Cells = cells and cells.Value or 0,
		Gems = gems and gems.Value or 0,
	}
end

local function IsKaijuOwned(kaijuName)
	local owned = GetOwnedKaijus()
	return owned[kaijuName] ~= nil
end

local function GetKaijuLevel(kaijuName)
	local owned = GetOwnedKaijus()
	return owned[kaijuName] and owned[kaijuName].Level or 0
end

local function CheckRequirementMet(reqName, reqData)
	local level = GetKaijuLevel(reqName)
	if reqData.Level and level < reqData.Level then return false, "Level " .. level .. "/" .. reqData.Level end
	if reqData.Kills then
		local owned = GetOwnedKaijus()
		local kills = owned[reqName] and owned[reqName].Kills or 0
		if kills < reqData.Kills then return false, "Kills " .. kills .. "/" .. reqData.Kills end
	end
	return true, "OK"
end

local function PurchaseKaiju(kaijuName)
	local rs = game:GetService("ReplicatedStorage")
	local purchaseRemote = rs.Remotes:FindFirstChild("PurchaseRemote")
	if not purchaseRemote then return false, "PurchaseRemote not found" end
	
	-- Check if it's an event kaiju (in GameData.Shop.Kaiju)
	local shared = rs:FindFirstChild("Shared")
	local isEventKaiju = false
	if shared then
		local gameData = shared:FindFirstChild("GameData")
		if gameData then
			local ok, gd = pcall(require, gameData)
			if ok and type(gd) == "table" and gd.Shop and gd.Shop.Kaiju and gd.Shop.Kaiju[kaijuName] then
				isEventKaiju = true
			end
		end
	end
	
	local ok, result = pcall(function()
		if isEventKaiju then
			return purchaseRemote:FireServer("Gift", { TargetId = game:GetService("Players").LocalPlayer.UserId, Name = kaijuName })
		else
			return purchaseRemote:FireServer("Buy", kaijuName)
		end
	end)
	
	if ok then
		return true, "Purchase request sent"
	else
		return false, "Purchase failed: " .. tostring(result)
	end
end

