local function HealthColor(percent)
	if percent > 0.6 then return Color3.fromRGB(50, 255, 50)
	elseif percent > 0.3 then return Color3.fromRGB(255, 255, 50)
	else return Color3.fromRGB(255, 50, 50) end
end

local function UpdateESPHealth(enemy)
	local esp = State.ESPObjects[enemy]
	if not esp or not esp.Humanoid or not esp.HealthLabel then return end
	local health = esp.Humanoid.Health
	local maxHealth = esp.Humanoid.MaxHealth
	if maxHealth <= 0 then return end
	local percent = math.clamp(health / maxHealth, 0, 1)
	esp.HealthLabel.Text = string.format("HP: %d / %d", math.floor(health), maxHealth)
	local col = HealthColor(percent)
	esp.HealthLabel.TextColor3 = col
	if esp.Highlight then
		esp.Highlight.FillColor = col
		esp.Highlight.OutlineColor = col
	end
end

local function UpdateESPDistance(enemy)
	local esp = State.ESPObjects[enemy]
	if not esp or not esp.HRP then return end
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end
	local ok, dist = pcall(GetDistance, myHRP.Position, esp.HRP.Position)
	if not ok then return end
	esp.DistanceLabel.Text = string.format("Dist: %.1f", dist)
	local visible = dist <= Config.ESP.MaxDistance
	esp.Billboard.Enabled = visible
	if esp.Highlight then
		esp.Highlight.Enabled = visible and Config.ESP.ShowChams
	end
end

local function CreateESP(enemy)
	if State.ESPObjects[enemy] then return end
	local humanoid = enemy:FindFirstChildOfClass("Humanoid") or enemy:FindFirstChild("Humanoid")
	local hrp = enemy:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	local kaijuName = enemy:GetAttribute("KaijuName") or enemy.Name

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "KaijuESP"
	billboard.Adornee = hrp
	billboard.Size = UDim2.new(0, 200, 0, 80)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = Config.ESP.MaxDistance
	billboard.ResetOnSpawn = false

	local function makeLabel(name, yPos)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, 20)
		l.Position = UDim2.new(0, 0, 0, yPos)
		l.Font = Enum.Font.Code
		l.TextSize = Config.ESP.TextSize
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0
		l.TextStrokeColor3 = Color3.new(0, 0, 0)
		l.Parent = billboard
		return l
	end

	local nameLabel = makeLabel("NameLabel", -25)
	nameLabel.Text = tostring(kaijuName)
	local healthLabel = makeLabel("HealthLabel", 0)
	local distanceLabel = makeLabel("DistanceLabel", 25)

	-- Parent al final para evitar flicker a medio construir
	billboard.Parent = hrp

	local highlight = Instance.new("Highlight")
	highlight.Name = "KaijuESP_Highlight"
	highlight.Adornee = enemy
	highlight.FillTransparency = Config.ESP.ChamsFillTransparency
	highlight.OutlineTransparency = Config.ESP.ChamsOutlineTransparency
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = Config.ESP.ShowChams
	highlight.Parent = enemy

	local conn = humanoid.HealthChanged:Connect(function()
		UpdateESPHealth(enemy)
	end)

	State.ESPObjects[enemy] = {
		Billboard = billboard, NameLabel = nameLabel, HealthLabel = healthLabel,
		DistanceLabel = distanceLabel, Highlight = highlight,
		Humanoid = humanoid, HRP = hrp, Conn = conn,
	}
	UpdateESPHealth(enemy)
	UpdateESPDistance(enemy)
end

local function RemoveESP(enemy)
	local esp = State.ESPObjects[enemy]
	if not esp then return end
	State.ESPObjects[enemy] = nil
	pcall(function() if esp.Conn then esp.Conn:Disconnect() end end)
	pcall(function() if esp.Billboard then esp.Billboard:Destroy() end end)
	pcall(function() if esp.Highlight then esp.Highlight:Destroy() end end)
end

local function ClearAllESP()
	local keys = {}
	for enemy in pairs(State.ESPObjects) do table.insert(keys, enemy) end
	for _, enemy in ipairs(keys) do RemoveESP(enemy) end
end

local function UpdateESP()
	if not Config.ESP.Enabled then
		ClearAllESP()
		return
	end
	for _, enemy in ipairs(GetEnemyKaijus()) do
		if not State.ESPObjects[enemy] then
			pcall(CreateESP, enemy)
		end
	end
	local dead = {}
	for enemy, esp in pairs(State.ESPObjects) do
		if not enemy.Parent or not esp.Humanoid or not esp.HRP or not esp.HRP.Parent or esp.Humanoid.Health <= 0 then
			table.insert(dead, enemy)
		else
			UpdateESPHealth(enemy)
			UpdateESPDistance(enemy)
			esp.NameLabel.Visible = Config.ESP.ShowName
			esp.HealthLabel.Visible = Config.ESP.ShowHealth
			esp.DistanceLabel.Visible = Config.ESP.ShowDistance
			if esp.Highlight then
				esp.Highlight.FillTransparency = Config.ESP.ChamsFillTransparency
				esp.Highlight.OutlineTransparency = Config.ESP.ChamsOutlineTransparency
			end
			esp.Billboard.MaxDistance = Config.ESP.MaxDistance
			esp.NameLabel.TextSize = Config.ESP.TextSize
			esp.HealthLabel.TextSize = Config.ESP.TextSize
			esp.DistanceLabel.TextSize = Config.ESP.TextSize
		end
	end
	for _, enemy in ipairs(dead) do RemoveESP(enemy) end
end

-- ================= MOVEMENT =================
-- Sistema sin stacking: guarda base limpia una vez, detecta cambios externos
-- del juego (stuns, cambio de kaiju, sprint del juego) y restaura al apagar.
local function GetSpeedMulti(myKaiju)
	if not myKaiju then return nil end
	return myKaiju:GetAttribute("SpeedMulti")
end

local function CaptureMoveBase(myKaiju)
	if not myKaiju then return end
	-- Si cambiamos de kaiju, resetea tracking
	if State.MoveKaiju ~= myKaiju then
		State.MoveKaiju = myKaiju
		State.MoveLastApplied = nil
		State.MoveLastMult = nil
	end
	if State.MoveBase == nil then
		State.MoveBase = GetSpeedMulti(myKaiju) or 1
	end
end

local function UpdateMovement()
	if not Config.Movement.Enabled then return end
	-- Throttle a ~10Hz: escribir SpeedMulti cada frame + arrastrar sliders = stacking
	local now = os.clock()
	if (now - State.LastMoveUpdate) < 0.1 then return end
	State.LastMoveUpdate = now

	local myKaiju = GetMyKaiju()
	if not myKaiju or not myKaiju.Parent then return end
	CaptureMoveBase(myKaiju)
	if State.MoveBase == nil then return end

	local sprintMult = 1 + (Config.Movement.SprintSpeedPercent / 100)
	local walkMult = 1 + (Config.Movement.WalkSpeedPercent / 100)

	-- Si ambos en 0%, no escribir nada (evita pelear con el juego).
	-- Si habíamos aplicado algo antes, restaura una vez.
	if sprintMult == 1 and walkMult == 1 then
		if State.MoveLastApplied ~= nil then
			local current = GetSpeedMulti(myKaiju) or 1
			if math.abs(current - State.MoveBase) > 0.02 then
				pcall(myKaiju.SetAttribute, myKaiju, "SpeedMulti", State.MoveBase)
			end
			State.MoveLastApplied = nil
			State.MoveLastMult = nil
		end
		State.IsSprinting = myKaiju:GetAttribute("IsRunning") == true
		return
	end

	local isRunning = myKaiju:GetAttribute("IsRunning") == true
	local wantMult = isRunning and sprintMult or walkMult
	local current = GetSpeedMulti(myKaiju) or 1

	-- ¿El juego cambió la base por fuera (stun, habilidad, otro kaiju)?
	-- Si current != lo último que escribimos, re-calcula base limpia.
	if State.MoveLastApplied ~= nil and State.MoveLastMult ~= nil and State.MoveLastMult ~= 0 then
		if math.abs(current - State.MoveLastApplied) > 0.05 then
			local inferredBase = current / State.MoveLastMult
			-- Sanity: la base debe ser razonable (0.1 - 50). Si no, ignora.
			if inferredBase > 0.05 and inferredBase < 100 then
				State.MoveBase = inferredBase
			else
				-- Cambio externo raro: re-captura sin dividir
				State.MoveBase = current
				State.MoveLastApplied = nil
				State.MoveLastMult = nil
			end
		end
	end

	local target = State.MoveBase * wantMult
	-- Tope del Anti: SpeedMulti válido en [1, 1.5]. Más no tiene efecto.
	if State.MoveBase > 0 and target > State.MoveBase * 1.5 then
		target = State.MoveBase * 1.5
	end
	if math.abs(current - target) > 0.02 then
		pcall(myKaiju.SetAttribute, myKaiju, "SpeedMulti", target)
		State.MoveLastApplied = target
		State.MoveLastMult = wantMult
	else
		-- Aunque no escribimos, actualiza tracking para detectar cambios externos
		if State.MoveLastApplied == nil then
			State.MoveLastApplied = current
			State.MoveLastMult = wantMult
		end
	end
	State.IsSprinting = isRunning
end

local function RestoreMovement()
	-- Solo tocamos SpeedMulti (1 = base limpia). NUNCA WalkSpeed directo:
	-- el Anti (PreSimulation + WalkSpeed.Changed) lo vigila y el Control
	-- del juego recalcula WalkSpeed solo. Forzar WalkSpeed dejaba todo trabado.
	local targets = {}
	if State.MoveKaiju and State.MoveKaiju.Parent then table.insert(targets, State.MoveKaiju) end
	local cur = GetMyKaiju(false)
	if cur and cur.Parent and cur ~= State.MoveKaiju then table.insert(targets, cur) end
	local base = State.MoveBase or State.InitialMoveBase or 1
	for _, t in ipairs(targets) do
		pcall(t.SetAttribute, t, "SpeedMulti", base)
	end
	State.MoveLastApplied = nil
	State.MoveLastMult = nil
	State.IsSprinting = false
end

local function ResetMovementState()
	-- El Anti solo deja SpeedMulti en [1, 1.5]. El Reset apaga, pone
	-- sliders a 0 y devuelve SpeedMulti a la base en bucle (sin tocar WalkSpeed).
	Config.Movement.Enabled = false
	Config.Movement.SprintSpeedPercent = 0
	Config.Movement.WalkSpeedPercent = 0
	pcall(function()
		local t = Tgl("MoveEnabled")
		if t then t:SetValue(false) end
		if MoveSprintSlider then MoveSprintSlider:SetValue(0) end
		if MoveWalkSlider then MoveWalkSlider:SetValue(0) end
	end)
	local base = State.MoveBase or State.InitialMoveBase or 1
	task.spawn(function()
		for i = 1, 10 do
			if State.Unloaded then break end
			local m = GetMyKaiju(false) or State.MoveKaiju
			if m and m.Parent then
				pcall(m.SetAttribute, m, "SpeedMulti", base)
			end
			task.wait(0.1)
		end
	end)
	RestoreMovement()
	State.MoveBase = nil
	State.MoveLastApplied = nil
	State.MoveLastMult = nil
	State.MoveKaiju = nil
	State.IsSprinting = false
end

-- ================= FARM (Beam a todo) =================
-- Usa los mismos hooks del silent: el beam lee Mouse.Hit cada frame,
-- así que rotar el objetivo = el rayo barre edificios/jugadores solo.
-- Tú solo mantienes el beam (tecla 5).
local function IsFarmActive()
	return Config.Farm.Builds or Config.Farm.Players
end

-- Wallcheck: rayo desde ti al objetivo; si hay pared en medio, no entra.
-- Sin esto el beam apunta a edificios/jugadores detrás de muros y falla.
local FarmRayParams = nil
local FarmRayFilter = {} -- Reused filter table to avoid GC churn (B8)
local function HasLOS(fromPos, toPos, targetModel, myKaiju)
	if not FarmRayParams then
		FarmRayParams = RaycastParams.new()
		FarmRayParams.FilterType = Enum.RaycastFilterType.Exclude
		FarmRayParams.IgnoreWater = true
	end
	FarmRayFilter[1] = myKaiju
	FarmRayParams.FilterDescendantsInstances = FarmRayFilter
	local dir = toPos - fromPos
	if dir.Magnitude < 1 then return true end
	local hit = Workspace:Raycast(fromPos, dir, FarmRayParams)
	if not hit then return true end
	return hit.Instance ~= nil and targetModel ~= nil and hit.Instance:IsDescendantOf(targetModel)
end

local function RefreshFarmTargets()
	local myKaiju = GetMyKaiju()
	if not myKaiju then State.FarmList = {} return end
	local myHRP = myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then State.FarmList = {} return end
	local myPos = myHRP.Position
	local list = {}
	if Config.Farm.Builds then
		-- Edificios estáticos: se cachean (re-escaneo cada 30s, no cada 2s).
		-- Escanear miles de instancias cada 2s congelaba el juego.
		local nowB = os.clock()
		if (nowB - (State.LastBuildScan or 0)) > 30 or #State.FarmBuildings == 0 then
			State.LastBuildScan = nowB
			State.FarmBuildings = {}
			local map = Workspace:FindFirstChild("Map")
			for _, fname in ipairs({ "CityFolder", "Tokyo" }) do
				local folder = map and map:FindFirstChild(fname)
				if folder then
					for _, m in ipairs(folder:GetDescendants()) do
						if #State.FarmBuildings >= 60 then break end
						if m:IsA("Model") and m.Parent and m:FindFirstChildWhichIsA("BasePart", true) then
							local ok, pv = pcall(function() return m:GetPivot().Position end)
							if ok then table.insert(State.FarmBuildings, { Model = m, Pos = pv }) end
						end
					end
				end
			end
		end
		for _, b in ipairs(State.FarmBuildings) do
			if b.Model.Parent and (b.Pos - myPos).Magnitude <= Config.Farm.BuildRange then
				if not Config.Farm.Wallcheck or HasLOS(myPos, b.Pos, b.Model, myKaiju) then
					table.insert(list, b.Model)
				end
			end
		end
	end
	if Config.Farm.Players then
		-- Rango por slider + wallcheck. Anti-spawn EXACTO: el juego marca
		-- IFrame=true al reaparecer (~5s); se salta por atributo, no por tiempo.
		-- Rango: infinito salvo modo eficiente (distancia corta = más daño).
		local prange = Config.Farm.Efficient and (Config.Farm.EfficientRange or 800) or math.huge
		for _, enemy in ipairs(GetEnemyKaijus()) do
			if enemy:GetAttribute("IFrame") ~= true then
				local hrp = enemy:FindFirstChild("HumanoidRootPart")
				if hrp and (hrp.Position - myPos).Magnitude <= prange
				and (not Config.Farm.Wallcheck or HasLOS(myPos, hrp.Position, enemy, myKaiju)) then
					table.insert(list, enemy)
				end
			end
		end
	end
	State.FarmList = list
	if State.FarmIdx > #list then State.FarmIdx = 1 end
end

-- Elige el beam: Attack5 solo si tienes Power suficiente, si no Attack4.
-- (Attack5 pedía Power=100 y por eso nunca salía con la barra vacía.)
local function PickBeamSkill()
	local fb, cb, eb = "Attack5", 70, 100
	pcall(function()
		local myKaiju = GetMyKaiju(false)
		if not myKaiju then return end
		local power = myKaiju:GetAttribute("Power") or 0
		local kn = myKaiju:GetAttribute("KaijuName")
		local kd = ReplicatedStorage:FindFirstChild("Shared")
		local km = kd and type(kn) == "string" and kd:FindFirstChild("KaijuData") and kd.KaijuData:FindFirstChild(kn)
		local data = km and require(km)
		local st = data and data.KaijuData and data.KaijuData.AttackStatics
		local a5 = st and st.Attack5
		local needPower = a5 and a5.Power or nil
		if type(needPower) == "number" and power < needPower then
			local a4 = st.Attack4
			if a4 then
				fb = "Attack4"
				if type(a4.Cooldown) == "number" then cb = a4.Cooldown end
				if type(a4.Energy) == "number" then eb = a4.Energy end
				return
			end
		end
		if a5 then
			if type(a5.Cooldown) == "number" then cb = a5.Cooldown end
			if type(a5.Energy) == "number" then eb = a5.Energy end
		end
	end)
	return fb, cb, eb
end

-- Lee cooldown y costo del beam (Attack5) de TU kaiju actual
local function BeamCostCD()
	local fb, cb, eb = PickBeamSkill()
	return cb, eb, fb
end

-- ================= HELPERS COMPARTIDOS (van ANTES de todo uso) =================
-- En Lua un local declarado DESPUÉS no existe para quien lo usa antes.
-- Todo lo de abajo lo usan AutoFarm/BeamAlto/Kill/Respawn/Islas.
local ISLANDS = {
	{ Name = "Tokyo", Pos = Vector3.new(114, 112, 4) },
	{ Name = "Desert", Pos = Vector3.new(-753, 112, 703) },
	{ Name = "Antarctica", Pos = Vector3.new(891, 144, 1046) },
	{ Name = "Skull Island", Pos = Vector3.new(-493, 112, -605) },
	{ Name = "Safezone", Pos = Vector3.new(1763, 108, 888) },
}

local function GetCombatRemote()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	return remotes and remotes:FindFirstChild("CombatRemote")
end

local function FireSkill(name)
	if State.Unloaded then return end
	local cr = GetCombatRemote()
	if cr then pcall(cr.FireServer, cr, "UseSkill", name) end
end

local function TeleportTo(pos)
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then return false end
	pcall(function() myHRP.CFrame = CFrame.new(pos) end)
	return true
end

local function TeleportIsland(name)
	if not name or name == "Actual" then return false end
	for _, isl in ipairs(ISLANDS) do
		if isl.Name == name then
			return TeleportTo(isl.Pos)
		end
	end
	return false
end

local function CurrentFarmTarget()
	if not IsFarmActive() or #State.FarmList == 0 then return nil end
	local t = State.FarmList[State.FarmIdx]
	if t and t.Parent then return t end
	return nil
end

-- Punto de mira para cualquier objetivo (kaiju con HRP o edificio con pivot)
local function SilentPoint(target)
	local p = target:FindFirstChild(Config.SilentAim.TargetPart) or target:FindFirstChild("HumanoidRootPart")
	if p then return p.Position end
	local ok, pv = pcall(function() return target:GetPivot().Position end)
	if ok then return pv end
	return nil
end

local function SilentTargetObj(target)
	local p = target:FindFirstChild(Config.SilentAim.TargetPart) or target:FindFirstChild("HumanoidRootPart")
	if p then return p end
	if target:IsA("BasePart") then return target end
	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("BasePart") then return d end
	end
	return nil
end

-- Centro de la isla donde estás (pivote conocido más cercano)
local function NearestIsland(pos)
	local best, bd = nil, math.huge
	for _, isl in ipairs(ISLANDS) do
		local d = (isl.Pos - pos).Magnitude
		if d < bd then best, bd = isl, d end
	end
	return best
end

local function FarmTick()
	if not IsFarmActive() or State.Unloaded then return end
	local now = os.clock()
	if (now - State.LastFarmRefresh) > 2 then
		State.LastFarmRefresh = now
		RefreshFarmTargets()
	end
	if #State.FarmList == 0 then return end
	-- Rotación máxima: cambia de objetivo CADA FRAME (sin slider)
	State.FarmIdx = (State.FarmIdx % #State.FarmList) + 1
end

-- Beam cielo: clavado en el aire sobre la isla, spameando beam con su CD
-- Auto farm: plataforma invisible en el cielo + spam de beam con su CD.
-- Sin plataforma caes por gravedad y parece que "no sube". Con plataforma
-- el juego te sostiene solo (física normal) y no hay que re-pinnear.
-- Refcount system (B6): multiple features can share the platform
local function AcquireSkyPlatform(skyTop)
	State.SkyPlatformUsers = (State.SkyPlatformUsers or 0) + 1
	return EnsureSkyPlatform(skyTop)
end

local function ReleaseSkyPlatform()
	State.SkyPlatformUsers = math.max(0, (State.SkyPlatformUsers or 0) - 1)
	if State.SkyPlatformUsers == 0 then
		DestroySkyPlatform()
	end
end

local function EnsureSkyPlatform(skyTop)
	local p = State.SkyPlatform
	if p and p.Parent then
		if (p.Position - (skyTop - Vector3.new(0, 1, 0))).Magnitude > 40 then
			pcall(function() p.CFrame = CFrame.new(skyTop - Vector3.new(0, 1, 0)) end)
		end
		return p
	end
	pcall(function() if p then p:Destroy() end end)
	State.SkyPlatform = nil
	local ok, part = pcall(function()
		local pt = Instance.new("Part")
		pt.Name = "KaijuHubSky"
		pt.Size = Vector3.new(60, 2, 60)
		pt.Anchored = true
		pt.CanCollide = true
		pt.CanTouch = false
		pt.CanQuery = false
		pt.Transparency = 1
		pt.CFrame = CFrame.new(skyTop - Vector3.new(0, 1, 0))
		pt.Parent = Workspace
		return pt
	end)
	if ok and part then State.SkyPlatform = part end
	return State.SkyPlatform
end

local function DestroySkyPlatform()
	if (State.SkyPlatformUsers or 0) > 0 then return end -- Don't destroy if still in use (B6)
	pcall(function() if State.SkyPlatform then State.SkyPlatform:Destroy() end end)
	State.SkyPlatform = nil
end

local function AutoFarmTick()
	if not Config.Farm.AutoFarm or State.Unloaded then return end
	local now = os.clock()
	if (now - (State.LastAutoTick or 0)) < 0.5 then return end
	State.LastAutoTick = now
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	local myHum = myKaiju and myKaiju:FindFirstChildOfClass("Humanoid")
	-- Health check: don't farm with dead kaiju (B3)
	if not myKaiju or not myHRP or not myHum or myHum.Health <= 0 then
		ReleaseSkyPlatform()
		return
	end
	local isl = NearestIsland(myHRP.Position)
	if not isl then return end
	local skyTop = Vector3.new(isl.Pos.X, isl.Pos.Y + (Config.Farm.SkyAlt or 150), isl.Pos.Z)
	AcquireSkyPlatform(skyTop)
	-- Si te tumban o caes, te devuelve arriba (mirando al objetivo)
	if myHRP.Position.Y < skyTop.Y - 25 then
		local face = CurrentFarmTarget()
		pcall(function()
			local fp = face and SilentPoint(face)
			local dest = Vector3.new(skyTop.X, skyTop.Y + 4, skyTop.Z)
			if fp then myHRP.CFrame = CFrame.lookAt(dest, fp)
			else myHRP.CFrame = CFrame.new(dest) end
		end)
	else
		-- Apunta con el cuerpo sin moverte (el beam sigue al objetivo)
		local face = CurrentFarmTarget()
		if face then
			local fp = SilentPoint(face)
			if fp then
				pcall(function()
					myHRP.CFrame = CFrame.lookAt(myHRP.Position, fp)
				end)
			end
		end
	end
	-- Dispara el beam disponible con cooldown listo y energía suficiente
	if now >= (State.NextBeamAt or 0) then
		local cd, cost, skill = BeamCostCD()
		local en = myKaiju:GetAttribute("Energy") or 100
		if en >= cost then
			FireSkill(skill)
			State.NextBeamAt = now + cd
			-- Throttle notify to avoid spam (B16)
			if not State.LastBeamNotify or (now - State.LastBeamNotify) > 10 then
				State.LastBeamNotify = now
				Notify(skill .. " disparado (próximo en " .. math.floor(cd) .. "s)", 3)
			end
		else
			State.NextBeamAt = now + 2
		end
	end
end

-- Fin preciso: según cómo empezó (objeto Beam o atributo). Ver HasMyBeam.
-- Beam alto: al detectar tu beam te sube a la plataforma y TE MANTIENE
-- ahí hasta que el beam acaba; luego vuelves a tu sitio anterior.
local function HasMyBeam()
	local has = false
	pcall(function()
		local bf = Workspace:FindFirstChild("Beam")
		has = bf ~= nil and bf:FindFirstChild(LocalPlayer.Name .. "_Beam") ~= nil
	end)
	return has
end

local function BeamAltoTick()
	if not Config.Farm.BeamAlto or Config.Farm.AutoFarm or State.Unloaded then return end
	local myKaiju = GetMyKaiju()
	local attrFire = myKaiju and myKaiju:GetAttribute("Attacking") == true
	local beamObj = HasMyBeam()
	local firing = attrFire or beamObj
	local now = os.clock()
	-- Flancos SEPARADOS: si no, al volver con el objeto aún vivo se
	-- re-dispara solo (guardaba la plataforma como origen: el doble salto).
	local attrRise = attrFire and not State.BeamAltoPrevAttr
	local objRise = beamObj and not State.BeamAltoPrevObj
	State.BeamAltoPrevAttr = attrFire
	State.BeamAltoPrevObj = beamObj
	if (attrRise or objRise) and not State.BeamAltoReturn then
		local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
		if not myHRP then State.BeamAltoPrev = firing return end
		State.BeamAltoReturn = myHRP.CFrame
		State.BeamAltoMode = beamObj and "beam" or "attr"
		State.BeamAltoEndAt = nil
		State.BeamAltoStartAt = now
		local isl = NearestIsland(myHRP.Position)
		if isl then
			local skyTop = Vector3.new(isl.Pos.X, isl.Pos.Y + (Config.Farm.SkyAlt or 70), isl.Pos.Z)
			State.AltoTop = skyTop
			AcquireSkyPlatform(skyTop)
			pcall(function()
				myHRP.CFrame = CFrame.new(Vector3.new(skyTop.X, skyTop.Y + 4, skyTop.Z))
			end)
		end
	elseif firing and State.BeamAltoReturn then
		local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
		if not myHRP then State.BeamAltoPrev = firing return end
		if State.AltoTop and (now - (State.LastAltoPin or 0)) >= 0.25 then
			State.LastAltoPin = now
			if myHRP.Position.Y < State.AltoTop.Y - 15 then
				local top = State.AltoTop
				pcall(function()
					local cf = myHRP.CFrame
					myHRP.CFrame = CFrame.new(Vector3.new(cf.Position.X, top.Y + 4, cf.Position.Z)) * (cf - cf.Position)
				end)
			end
		end
		-- Fin: lo PRIMERO que ocurra según el modo (objeto fuera +0.3s,
		-- atributo caído +0.2s). Sin re-disparos: los flancos ya quedaron atrás.
		if State.BeamAltoMode == "beam" and not beamObj then
			if not State.BeamAltoEndAt then State.BeamAltoEndAt = now + 0.3 end
		elseif State.BeamAltoMode == "attr" and not attrFire then
			if not State.BeamAltoEndAt then State.BeamAltoEndAt = now + 0.2 end
		else
			State.BeamAltoEndAt = nil
		end
		if State.BeamAltoEndAt and now >= State.BeamAltoEndAt then
			firing = false
		end
	end
	if not firing and State.BeamAltoPrev and State.BeamAltoReturn then
		local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
		if myHRP then pcall(function() myHRP.CFrame = State.BeamAltoReturn end) end
		State.BeamAltoReturn = nil
		State.AltoTop = nil
		State.BeamAltoEndAt = nil
		ReleaseSkyPlatform()
	end
	State.BeamAltoPrev = firing
end

-- ================= SILENT AIMBOT (hooks, tu mira no se mueve) =================
-- Engancha lo que el juego LEE para apuntar (igual que un silent universal):
--  1) Mouse.Hit / Mouse.Target -> devuelve al enemigo.
--  2) workspace:Raycast de puntería -> redirige el rayo al enemigo.
-- Objetivo = enemigo más cercano a TU MOUSE dentro del círculo FOV.
-- Tu cursor y tu cámara no se mueven: es silent de verdad.
-- Forward: FindBoss se define en la sección Boss (después). Como los hooks
-- llaman en runtime (post-carga), el local ya estará asignado.
local FindBoss
local function GetSilentTarget()
	-- Con boss farm: SIEMPRE al jefe (no es opcional, va primero que todo)
	if Config.BossFarm.Enabled then
		local boss = FindBoss()
		if boss then return boss end
	end
	-- Farm tiene prioridad: rota por la lista sin importar el mouse
	local farm = CurrentFarmTarget()
	if farm then return farm end
	local myKaiju = GetMyKaiju()
	if not myKaiju then return nil end
	local myHRP = myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then return nil end
	local mOk, m = pcall(function() return UserInputService:GetMouseLocation() end)
	if not mOk then return nil end
	local best, bestD = nil, Config.Aim.FOV
	for _, enemy in ipairs(GetEnemyKaijus()) do
		local hrp = enemy:FindFirstChild("HumanoidRootPart")
		if hrp then
			if (hrp.Position - myHRP.Position).Magnitude <= Config.SilentAim.Range then
				local ok, sp, onScreen = pcall(function() return Camera:WorldToViewportPoint(hrp.Position) end)
				if ok and onScreen then
					local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(m.X, m.Y)).Magnitude
					if d < bestD then best, bestD = enemy, d end
				end
			end
		end
	end
	return best
end

local function SilentGated()
	if State.Unloaded then return false end
	local farmOn = IsFarmActive() and CurrentFarmTarget() ~= nil
	local bossOn = Config.BossFarm.Enabled and FindBoss() ~= nil
	if not Config.SilentAim.Enabled and not farmOn and not bossOn then return false end
	if Config.SilentAim.OnlyWhileAttacking and not farmOn and not bossOn then
		local myKaiju = GetMyKaiju()
		if not myKaiju or myKaiju:GetAttribute("Attacking") ~= true then return false end
	end
	return true
end

local function InstallSilentHooks()
	-- Allow installing missing hooks if only one was installed (B10)
	if State.IndexOld and State.NamecallOld then return true end
	if typeof(hookmetamethod) ~= "function" or typeof(newcclosure) ~= "function" then
		warn("[Silent] Sin hookmetamethod/newcclosure")
		return false
	end
	pcall(function()
		State.SilentMouse = LocalPlayer:GetMouse()
	end)
	if not State.IndexOld then
		pcall(function()
			State.IndexOld = hookmetamethod(game, "__index", newcclosure(function(self, k)
				if (k == "Hit" or k == "Target") and self == State.SilentMouse and SilentGated() then
					local isExec = false
					pcall(function() isExec = checkcaller() end)
					if not isExec then
						local target = GetSilentTarget()
						local pos = target and SilentPoint(target)
						if pos then
							if k == "Hit" then return CFrame.new(pos) end
							return SilentTargetObj(target)
						end
					end
				end
				return State.IndexOld(self, k)
			end))
		end)
	end
	if not State.NamecallOld then
		pcall(function()
			State.NamecallOld = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local method = getnamecallmethod()
				if method == "Raycast" and self == Workspace and SilentGated() then
					local isExec = false
					pcall(function() isExec = checkcaller() end)
					if not isExec then
						local args = { ... }
						local origin, dir = args[1], args[2]
						if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" and dir.Magnitude > 100 then
							local target = GetSilentTarget()
							local pos = target and SilentPoint(target)
							if pos then
								local toT = pos - origin
								if toT.Magnitude <= dir.Magnitude + 100 then
									args[2] = toT.Unit * dir.Magnitude
									return State.NamecallOld(self, unpack(args))
								end
							end
						end
					end
				end
				return State.NamecallOld(self, ...)
			end))
		end)
	end
	local ok = (State.IndexOld ~= nil) or (State.NamecallOld ~= nil)
	if ok then print("[Silent] Hooks instalados (Mouse + Raycast)") end
	return ok
end

local function RemoveSilentHooks()
	if State.IndexOld then
		pcall(function() hookmetamethod(game, "__index", State.IndexOld) end)
		State.IndexOld = nil
	end
	if State.NamecallOld then
		pcall(function() hookmetamethod(game, "__namecall", State.NamecallOld) end)
		State.NamecallOld = nil
	end
end

