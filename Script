-- BossBarTarget (el mismo que usa su barra de vida) + modelos AI_ con HP alto.
-- Zona de espera = BossPortal (1916,77,873).
local BOSS_PORTAL = Vector3.new(1916, 82, 873)

FindBoss = function()
	for _, m in ipairs(game:GetService("CollectionService"):GetTagged("BossBarTarget")) do
		if m.Parent then
			local h = m:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then return m end
		end
	end
	local live = GetLiveFolder()
	if live then
		for _, m in ipairs(live:GetChildren()) do
			if m:IsA("Model") and (m.Name:sub(1, 3) == "AI_" or m.Name:find("Boss")) then
				local h = m:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 then return m end
			end
		end
	end
	return nil
end

