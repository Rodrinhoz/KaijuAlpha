-- ================= SAFE HELPERS =================
local function GetLiveFolder()
	return Workspace:FindFirstChild("Live")
end

local function GetMyKaiju(useCache)
	local now = os.clock()
	if useCache ~= false and State.MyKaijuCache and State.MyKaijuCache.Parent and (now - State.MyKaijuCheckedAt) < 1 then
		return State.MyKaijuCache
	end
	local live = GetLiveFolder()
	if not live then return nil end
	for _, model in ipairs(live:GetChildren()) do
		if model:IsA("Model") and model.Name == LocalPlayer.Name then
			State.MyKaijuCache = model
			State.MyKaijuCheckedAt = now
			return model
		end
	end
	return nil
end

local function InvalidateKaijuCache()
	State.MyKaijuCache = nil
	-- NOTA: no tocamos MoveBase aquí. Invalidar la base con cualquier
	-- enemigo que spawnea/muere era lo que causaba stacking y valores raros.
end

local function OnMyKaijuChanged()
	-- Solo llamar cuando MI kaiju cambia (respawn / muerte), no con enemigos.
	-- Restaura el kaiju viejo si quedó con velocidad modificada.
	if State.MoveKaiju and State.MoveKaiju.Parent and State.MoveBase ~= nil then
		pcall(State.MoveKaiju.SetAttribute, State.MoveKaiju, "SpeedMulti", State.MoveBase)
	end
	-- Cleanup boss weld (B14)
	UnweldBoss()
	-- Cleanup BeamAlto state on death (B7)
	State.BeamAltoReturn = nil
	State.BeamAltoMode = nil
	State.BeamAltoEndAt = nil
	State.AltoTop = nil
	State.BeamAltoPrev = false
	State.BeamAltoPrevAttr = false
	State.BeamAltoPrevObj = false
	State.BeamAltoStartAt = 0
	State.LastAltoPin = 0
	-- Cleanup AutoFarm platform on death (B3)
	ReleaseSkyPlatform()
	State.MyKaijuCache = nil
	State.MoveBase = nil
	State.MoveLastApplied = nil
	State.MoveLastMult = nil
	State.MoveKaiju = nil
	State.IsSprinting = false
end

local function GetEnemyKaijus()
	local enemies = {}
	local live = GetLiveFolder()
	if not live then return enemies end
	local myKaiju = GetMyKaiju()
	for _, model in ipairs(live:GetChildren()) do
		if model:IsA("Model") and model ~= myKaiju and model.Name ~= LocalPlayer.Name then
			local humanoid = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("Humanoid")
			if humanoid and humanoid.Health > 0 then
				-- TeamCheck: en este juego no hay Teams clásicos, se filtra por nombre propio.
				-- Si Config.ESP.TeamCheck está activo, al menos evitamos nuestro propio modelo.
				table.insert(enemies, model)
			end
		end
	end
	return enemies
end

local function GetTargetPart(model)
	local want = Config.Aim.TargetPart
	if type(want) == "string" and want ~= "" then
		local p = model:FindFirstChild(want)
		if p and p:IsA("BasePart") then return p end
	end
	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

