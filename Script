local function FarmTick()
	if not IsFarmActive() or State.Unloaded then return end
	local now = os.clock()
	if (now - State.LastFarmRefresh) > 2 then
		State.LastFarmRefresh = now
		RefreshFarmTargets()
	end
	if #State.FarmList == 0 then return end
	-- Dwell 4s por blanco en vez de rotar cada frame o fijarlo: el beam
	-- necesita contacto para dañar, pero hay que cubrir a todos (incluso
	-- fuera de tu vista: la mira es el hook, no tu cámara).
	local cur = State.FarmList[State.FarmIdx]
	local isPlayer = cur and cur.Parent and cur:FindFirstChildOfClass("Humanoid") ~= nil
	if isPlayer then
		if (now - (State.LastPlayerHold or 0)) > 4 then
			State.LastPlayerHold = now
			State.FarmIdx = (State.FarmIdx % #State.FarmList) + 1
		end
	else
		State.FarmIdx = (State.FarmIdx % #State.FarmList) + 1
	end
end

-- Beam cielo: clavado en el aire sobre la isla, spameando beam con su CD
-- Auto farm: plataforma invisible en el cielo + spam de beam con su CD.
-- Sin plataforma caes por gravedad y parece que "no sube". Con plataforma
-- el juego te sostiene solo (física normal) y no hay que re-pinnear.
local function EnsureSkyPlatform(skyTop)
	local p = State.SkyPlatform
	if p and p.Parent then
		local wrongSize = true
		pcall(function()
			wrongSize = (p.Size - Vector3.new(12, 1, 12)).Magnitude > 0.5
		end)
		if wrongSize then
			pcall(function() p:Destroy() end)
			State.SkyPlatform = nil
			p = nil
		elseif (p.Position - (skyTop - Vector3.new(0, 1, 0))).Magnitude > 40 then
			pcall(function() p.CFrame = CFrame.new(skyTop - Vector3.new(0, 1, 0)) end)
		else
			return p
		end
	end
	pcall(function() if p then p:Destroy() end end)
	State.SkyPlatform = nil
	local ok, part = pcall(function()
		local pt = Instance.new("Part")
		pt.Name = "KaijuHubSky"
		pt.Size = Vector3.new(12, 1, 12)
		pt.Anchored = true
		pt.CanCollide = true
		pt.CanTouch = false
		pt.CanQuery = false
		pt.Transparency = 1
		pt.CFrame = CFrame.new(skyTop - Vector3.new(0, 1, 0))
		pt.Parent = Workspace
		return pt
	end)
	if ok and part then State.SkyPlatform = part end
	return State.SkyPlatform
end

-- Centroide real de CityFolder (1063 edificios, medido en vivo: 346,45,-274).
-- El autofarm de misiones te lleva aquí y reutiliza la plataforma invisible
-- de AutoFarmTick (EnsureSkyPlatform, 60x2x60, Transparency=1): sin partes
-- visibles gigantes ni BodyPosition/BodyGyro extra que el juego pueda limpiar.
local BUILD_CENTER = Vector3.new(346, 45, -274)
local BUILD_HOVER_H = 85 -- altura sobre el centroide (quedas en ~Y130)
-- Plataforma fija del beam a jugadores: sobre la isla Tokyo, altura
-- moderada. Se usa CON colisión y quieto (en freefall o sin apoyo el
-- servidor rechaza los skills).
local TOKYO_FARM_TOP = Vector3.new(100, 95, -60)

-- Lleva al centro de edificios. La plataforma + disparo los pone AutoFarmTick.
-- Solo teletransporta si estás lejos (>60) para no cortar tu beam a cada tick.
-- Puntos de farmeo: agua REAL (océano con IsSwimming, Y≈25 sumergido;
-- el otro océano es falso y no activa natación) y cielo arriba.
local SWIM_SPOT = Vector3.new(-52, 25, 300)
local FLY_SPOT = Vector3.new(-52, 150, -2000)

-- Movimiento para swim/fly: saltos RELATIVOS ±150 cada 1s (receta
-- medida: +1800/24s swim; los saltos grandes >200 casi no cuentan y
-- clavarse quieto tampoco). Swim fija Y=25 (en el agua); fly mantiene
-- su altura. Si te alejas >600 del punto, recentra.
local function QuestMoveTick()
	local mv = State.QuestMove
	if not mv or State.Unloaded then return end
	if not Config.Quests.Auto then State.QuestMove = nil return end
	local now = os.clock()
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myKaiju or not myHRP then return end
	if (now - (State.LastMoveHop or 0)) < 1 then return end
	State.LastMoveHop = now
	if not SpawnSettled() then return end
	State.MovePhase = not State.MovePhase
	pcall(function()
		local p = myHRP.Position
		local flatD = (Vector3.new(p.X, 0, p.Z) - Vector3.new(mv.center.X, 0, mv.center.Z)).Magnitude
		local dest
		if flatD > 600 then
			dest = mv.center
		else
			local dir = State.MovePhase and 1 or -1
			local y = (mv.kind == "swim") and 25 or mv.center.Y
			dest = Vector3.new(p.X + 150 * dir, y, p.Z)
		end
		myHRP.CFrame = CFrame.new(dest)
	end)
end

