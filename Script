-- ================= FOV CIRCLE =================
-- Círculo rehecho: se auto-repara si el executor lo mata, sigue el tamaño
-- de ventana y su radio ES la zona de adquisición del silent/farm.
local function DestroyFOVCircle()
	if State.FOVCircle then
		pcall(function()
			if State.FOVCircle.Remove then State.FOVCircle:Remove()
			elseif State.FOVCircle.Destroy then State.FOVCircle:Destroy() end
		end)
		State.FOVCircle = nil
	end
end

local function FOVAlive()
	local c = State.FOVCircle
	if not c then return false end
	local ok = pcall(function()
		local _ = c.Visible
		c.Radius = c.Radius -- lectura+escritura de prueba
	end)
	return ok
end

local function CreateFOVCircle()
	DestroyFOVCircle()
	if typeof(Drawing) ~= "table" and typeof(Drawing) ~= "userdata" then
		local ok = pcall(function() return Drawing.new end)
		if not ok then
			warn("[Kaiju Hub] Drawing no soportado (FOV desactivado)")
			return
		end
	end
	local ok, circle = pcall(function() return Drawing.new("Circle") end)
	if not ok or not circle then
		warn("[Kaiju Hub] Drawing.new falló (FOV desactivado)")
		return
	end
	State.FOVCircle = circle
	pcall(function()
		circle.Visible = FOVShouldShow()
		circle.Radius = Config.Aim.FOV
		circle.Color = Config.Aim.FOVColor
		circle.Thickness = 2
		circle.Transparency = 1
		circle.Filled = false
		circle.NumSides = 64
		circle.ZIndex = 1
		local vs = Camera.ViewportSize
		if vs.X > 0 and vs.Y > 0 then
			circle.Position = Vector2.new(vs.X / 2, vs.Y / 2)
		end
	end)
end

local function UpdateFOVCircle()
	if State.Unloaded then return end
	-- Auto-reparación (máx 1 intento/segundo para no spamear)
	if not FOVAlive() then
		local now = os.clock()
		if (now - (State.LastFOVCreate or 0)) > 1 then
			State.LastFOVCreate = now
			CreateFOVCircle()
		end
		return
	end
	pcall(function()
		local c = State.FOVCircle
		c.Visible = FOVShouldShow()
		c.Radius = Config.Aim.FOV
		c.Color = Config.Aim.FOVColor
		local vs = Camera.ViewportSize
		if vs.X > 0 and vs.Y > 0 then
			c.Position = Vector2.new(vs.X / 2, vs.Y / 2)
		end
	end)
end

-- ================= ESP =================
local function HealthColor(percent)
	if percent > 0.6 then return Color3.fromRGB(50, 255, 50)
	elseif percent > 0.3 then return Color3.fromRGB(255, 255, 50)
	else return Color3.fromRGB(255, 50, 50) end
end

local function UpdateESPHealth(enemy)
	local esp = State.ESPObjects[enemy]
	if not esp or not esp.Humanoid or not esp.HealthLabel then return end
	local health = esp.Humanoid.Health
	local maxHealth = esp.Humanoid.MaxHealth
	if maxHealth <= 0 then return end
	local percent = math.clamp(health / maxHealth, 0, 1)
	esp.HealthLabel.Text = string.format("HP: %d / %d", math.floor(health), maxHealth)
	local col = HealthColor(percent)
	esp.HealthLabel.TextColor3 = col
	if esp.Highlight then
		esp.Highlight.FillColor = col
		esp.Highlight.OutlineColor = col
	end
end

local function UpdateESPDistance(enemy)
	local esp = State.ESPObjects[enemy]
	if not esp or not esp.HRP then return end
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end
	local ok, dist = pcall(GetDistance, myHRP.Position, esp.HRP.Position)
	if not ok then return end
	esp.DistanceLabel.Text = string.format("Dist: %.1f", dist)
	local visible = dist <= Config.ESP.MaxDistance
	esp.Billboard.Enabled = visible
	if esp.Highlight then
		esp.Highlight.Enabled = visible and Config.ESP.ShowChams
	end
end

local function CreateESP(enemy)
	if State.ESPObjects[enemy] then return end
	local humanoid = enemy:FindFirstChildOfClass("Humanoid") or enemy:FindFirstChild("Humanoid")
	local hrp = enemy:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	local kaijuName = enemy:GetAttribute("KaijuName") or enemy.Name

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "KaijuESP"
	billboard.Adornee = hrp
	billboard.Size = UDim2.new(0, 200, 0, 80)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = Config.ESP.MaxDistance
	billboard.ResetOnSpawn = false

	local function makeLabel(name, yPos)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, 20)
		l.Position = UDim2.new(0, 0, 0, yPos)
		l.Font = Enum.Font.Code
		l.TextSize = Config.ESP.TextSize
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0
		l.TextStrokeColor3 = Color3.new(0, 0, 0)
		l.Parent = billboard
		return l
	end

	local nameLabel = makeLabel("NameLabel", -25)
	nameLabel.Text = tostring(kaijuName)
	local healthLabel = makeLabel("HealthLabel", 0)
	local distanceLabel = makeLabel("DistanceLabel", 25)

	-- Parent al final para evitar flicker a medio construir
	billboard.Parent = hrp

	local highlight = Instance.new("Highlight")
	highlight.Name = "KaijuESP_Highlight"
	highlight.Adornee = enemy
	highlight.FillTransparency = Config.ESP.ChamsFillTransparency
	highlight.OutlineTransparency = Config.ESP.ChamsOutlineTransparency
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = Config.ESP.ShowChams
	highlight.Parent = enemy

	local conn = humanoid.HealthChanged:Connect(function()
		UpdateESPHealth(enemy)
	end)

	State.ESPObjects[enemy] = {
		Billboard = billboard, NameLabel = nameLabel, HealthLabel = healthLabel,
		DistanceLabel = distanceLabel, Highlight = highlight,
		Humanoid = humanoid, HRP = hrp, Conn = conn,
	}
	UpdateESPHealth(enemy)
	UpdateESPDistance(enemy)
end

local function RemoveESP(enemy)
	local esp = State.ESPObjects[enemy]
	if not esp then return end
	State.ESPObjects[enemy] = nil
	pcall(function() if esp.Conn then esp.Conn:Disconnect() end end)
	pcall(function() if esp.Billboard then esp.Billboard:Destroy() end end)
	pcall(function() if esp.Highlight then esp.Highlight:Destroy() end end)
end

local function ClearAllESP()
	local keys = {}
	for enemy in pairs(State.ESPObjects) do table.insert(keys, enemy) end
	for _, enemy in ipairs(keys) do RemoveESP(enemy) end
end

local function UpdateESP()
	if not Config.ESP.Enabled then
		ClearAllESP()
		return
	end
	for _, enemy in ipairs(GetEnemyKaijus()) do
		if not State.ESPObjects[enemy] then
			pcall(CreateESP, enemy)
		end
	end
	local dead = {}
	for enemy, esp in pairs(State.ESPObjects) do
		if not enemy.Parent or not esp.Humanoid or not esp.HRP or not esp.HRP.Parent or esp.Humanoid.Health <= 0 then
			table.insert(dead, enemy)
		else
			UpdateESPHealth(enemy)
			UpdateESPDistance(enemy)
			esp.NameLabel.Visible = Config.ESP.ShowName
			esp.HealthLabel.Visible = Config.ESP.ShowHealth
			esp.DistanceLabel.Visible = Config.ESP.ShowDistance
			if esp.Highlight then
				esp.Highlight.FillTransparency = Config.ESP.ChamsFillTransparency
				esp.Highlight.OutlineTransparency = Config.ESP.ChamsOutlineTransparency
			end
			esp.Billboard.MaxDistance = Config.ESP.MaxDistance
			esp.NameLabel.TextSize = Config.ESP.TextSize
			esp.HealthLabel.TextSize = Config.ESP.TextSize
			esp.DistanceLabel.TextSize = Config.ESP.TextSize
		end
	end
	for _, enemy in ipairs(dead) do RemoveESP(enemy) end
end

-- ================= MOVEMENT =================
-- Sistema sin stacking: guarda base limpia una vez, detecta cambios externos
-- del juego (stuns, cambio de kaiju, sprint del juego) y restaura al apagar.
local function GetSpeedMulti(myKaiju)
	if not myKaiju then return nil end
	return myKaiju:GetAttribute("SpeedMulti")
end

local function CaptureMoveBase(myKaiju)
	if not myKaiju then return end
	-- Si cambiamos de kaiju, resetea tracking
	if State.MoveKaiju ~= myKaiju then
		State.MoveKaiju = myKaiju
		State.MoveLastApplied = nil
		State.MoveLastMult = nil
	end
	if State.MoveBase == nil then
		State.MoveBase = GetSpeedMulti(myKaiju) or 1
	end
end

local function UpdateMovement()
	if not Config.Movement.Enabled then return end
	-- Throttle a ~10Hz: escribir SpeedMulti cada frame + arrastrar sliders = stacking
	local now = os.clock()
	if (now - State.LastMoveUpdate) < 0.1 then return end
	State.LastMoveUpdate = now

	local myKaiju = GetMyKaiju()
	if not myKaiju or not myKaiju.Parent then return end
	CaptureMoveBase(myKaiju)
	if State.MoveBase == nil then return end

	local sprintMult = 1 + (Config.Movement.SprintSpeedPercent / 100)
	local walkMult = 1 + (Config.Movement.WalkSpeedPercent / 100)

	-- Si ambos en 0%, no escribir nada (evita pelear con el juego).
	-- Si habíamos aplicado algo antes, restaura una vez.
	if sprintMult == 1 and walkMult == 1 then
		if State.MoveLastApplied ~= nil then
			local current = GetSpeedMulti(myKaiju) or 1
			if math.abs(current - State.MoveBase) > 0.02 then
				pcall(myKaiju.SetAttribute, myKaiju, "SpeedMulti", State.MoveBase)
			end
			State.MoveLastApplied = nil
			State.MoveLastMult = nil
		end
		State.IsSprinting = myKaiju:GetAttribute("IsRunning") == true
		return
	end

	local isRunning = myKaiju:GetAttribute("IsRunning") == true
	local wantMult = isRunning and sprintMult or walkMult
	local current = GetSpeedMulti(myKaiju) or 1

	-- ¿El juego cambió la base por fuera (stun, habilidad, otro kaiju)?
	-- Si current != lo último que escribimos, re-calcula base limpia.
	if State.MoveLastApplied ~= nil and State.MoveLastMult ~= nil and State.MoveLastMult ~= 0 then
		if math.abs(current - State.MoveLastApplied) > 0.05 then
			local inferredBase = current / State.MoveLastMult
			-- Sanity: la base debe ser razonable (0.1 - 50). Si no, ignora.
			if inferredBase > 0.05 and inferredBase < 100 then
				State.MoveBase = inferredBase
			else
				-- Cambio externo raro: re-captura sin dividir
				State.MoveBase = current
				State.MoveLastApplied = nil
				State.MoveLastMult = nil
			end
		end
	end

	local target = State.MoveBase * wantMult
	-- Tope del Anti: SpeedMulti válido en [1, 1.5]. Más no tiene efecto.
	if State.MoveBase > 0 and target > State.MoveBase * 1.5 then
		target = State.MoveBase * 1.5
	end
	if math.abs(current - target) > 0.02 then
		pcall(myKaiju.SetAttribute, myKaiju, "SpeedMulti", target)
		State.MoveLastApplied = target
		State.MoveLastMult = wantMult
	else
		-- Aunque no escribimos, actualiza tracking para detectar cambios externos
		if State.MoveLastApplied == nil then
			State.MoveLastApplied = current
			State.MoveLastMult = wantMult
		end
	end
	State.IsSprinting = isRunning
end

local function RestoreMovement()
	-- Solo tocamos SpeedMulti (1 = base limpia). NUNCA WalkSpeed directo:
	-- el Anti (PreSimulation + WalkSpeed.Changed) lo vigila y el Control
	-- del juego recalcula WalkSpeed solo. Forzar WalkSpeed dejaba todo trabado.
	local targets = {}
	if State.MoveKaiju and State.MoveKaiju.Parent then table.insert(targets, State.MoveKaiju) end
	local cur = GetMyKaiju(false)
	if cur and cur.Parent and cur ~= State.MoveKaiju then table.insert(targets, cur) end
	local base = State.MoveBase or State.InitialMoveBase or 1
	for _, t in ipairs(targets) do
		pcall(t.SetAttribute, t, "SpeedMulti", base)
	end
	State.MoveLastApplied = nil
	State.MoveLastMult = nil
	State.IsSprinting = false
end

local function ResetMovementState()
	-- El Anti solo deja SpeedMulti en [1, 1.5]. El Reset apaga, pone
	-- sliders a 0 y devuelve SpeedMulti a la base en bucle (sin tocar WalkSpeed).
	Config.Movement.Enabled = false
	Config.Movement.SprintSpeedPercent = 0
	Config.Movement.WalkSpeedPercent = 0
	pcall(function()
		local t = Tgl("MoveEnabled")
		if t then t:SetValue(false) end
		if Options.MoveSprint then Options.MoveSprint:SetValue(0) end
		if Options.MoveWalk then Options.MoveWalk:SetValue(0) end
	end)
	local base = State.MoveBase or State.InitialMoveBase or 1
	task.spawn(function()
		for i = 1, 10 do
			if State.Unloaded then break end
			local m = GetMyKaiju(false) or State.MoveKaiju
			if m and m.Parent then
				pcall(m.SetAttribute, m, "SpeedMulti", base)
			end
			task.wait(0.1)
		end
	end)
	RestoreMovement()
	State.MoveBase = nil
	State.MoveLastApplied = nil
	State.MoveLastMult = nil
	State.MoveKaiju = nil
	State.IsSprinting = false
end

-- ================= FARM (Beam a todo) =================
-- Usa los mismos hooks del silent: el beam lee Mouse.Hit cada frame,
-- así que rotar el objetivo = el rayo barre edificios/jugadores solo.
-- Tú solo mantienes el beam (tecla 5).
local function IsFarmActive()
	return Config.Farm.Builds or Config.Farm.Players
end

-- Wallcheck: rayo desde ti al objetivo; si hay pared en medio, no entra.
-- Sin esto el beam apunta a edificios/jugadores detrás de muros y falla.
local FarmRayParams = nil
local function HasLOS(fromPos, toPos, targetModel, myKaiju)
	if not FarmRayParams then
		FarmRayParams = RaycastParams.new()
		FarmRayParams.FilterType = Enum.RaycastFilterType.Exclude
		FarmRayParams.IgnoreWater = true
	end
	FarmRayParams.FilterDescendantsInstances = { myKaiju }
	local dir = toPos - fromPos
	if dir.Magnitude < 1 then return true end
	local hit = Workspace:Raycast(fromPos, dir, FarmRayParams)
	if not hit then return true end
	return hit.Instance ~= nil and targetModel ~= nil and hit.Instance:IsDescendantOf(targetModel)
end

local function RefreshFarmTargets()
	local myKaiju = GetMyKaiju()
	if not myKaiju then State.FarmList = {} return end
	local myHRP = myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then State.FarmList = {} return end
	local myPos = myHRP.Position
	local list = {}
	if Config.Farm.Builds then
		-- Edificios estáticos: se cachean (re-escaneo cada 30s, no cada 2s).
		-- Escanear miles de instancias cada 2s congelaba el juego.
		local nowB = os.clock()
		if (nowB - (State.LastBuildScan or 0)) > 30 or #State.FarmBuildings == 0 then
			State.LastBuildScan = nowB
			State.FarmBuildings = {}
			local map = Workspace:FindFirstChild("Map")
			for _, fname in ipairs({ "CityFolder", "Tokyo" }) do
				local folder = map and map:FindFirstChild(fname)
				if folder then
					for _, m in ipairs(folder:GetDescendants()) do
						if #State.FarmBuildings >= 60 then break end
						if m:IsA("Model") and m.Parent and m:FindFirstChildWhichIsA("BasePart", true) then
							local ok, pv = pcall(function() return m:GetPivot().Position end)
							if ok then table.insert(State.FarmBuildings, { Model = m, Pos = pv }) end
						end
					end
				end
			end
		end
		for _, b in ipairs(State.FarmBuildings) do
			if b.Model.Parent and (b.Pos - myPos).Magnitude <= Config.Farm.BuildRange then
				if not Config.Farm.Wallcheck or HasLOS(myPos, b.Pos, b.Model, myKaiju) then
					table.insert(list, b.Model)
				end
			end
		end
	end
	if Config.Farm.Players then
		-- Rango por slider + wallcheck. Anti-spawn EXACTO: el juego marca
		-- IFrame=true al reaparecer (~5s); se salta por atributo, no por tiempo.
		-- Rango: infinito salvo modo eficiente (distancia corta = más daño).
		local prange = Config.Farm.Efficient and (Config.Farm.EfficientRange or 800) or math.huge
		for _, enemy in ipairs(GetEnemyKaijus()) do
			if enemy:GetAttribute("IFrame") ~= true then
				local hrp = enemy:FindFirstChild("HumanoidRootPart")
				if hrp and (hrp.Position - myPos).Magnitude <= prange
				and (not Config.Farm.Wallcheck or HasLOS(myPos, hrp.Position, enemy, myKaiju)) then
					table.insert(list, enemy)
				end
			end
		end
	end
	State.FarmList = list
	if State.FarmIdx > #list then State.FarmIdx = 1 end
end

-- Elige el beam: Attack5 solo si tienes Power suficiente, si no Attack4.
-- (Attack5 pedía Power=100 y por eso nunca salía con la barra vacía.)
local function PickBeamSkill()
	local fb, cb, eb = "Attack5", 70, 100
	pcall(function()
		local myKaiju = GetMyKaiju(false)
		if not myKaiju then return end
		local power = myKaiju:GetAttribute("Power") or 0
		local kn = myKaiju:GetAttribute("KaijuName")
		local kd = ReplicatedStorage:FindFirstChild("Shared")
		local km = kd and type(kn) == "string" and kd:FindFirstChild("KaijuData") and kd.KaijuData:FindFirstChild(kn)
		local data = km and require(km)
		local st = data and data.KaijuData and data.KaijuData.AttackStatics
		local a5 = st and st.Attack5
		local needPower = a5 and a5.Power or nil
		if type(needPower) == "number" and power < needPower then
			local a4 = st.Attack4
			if a4 then
				fb = "Attack4"
				if type(a4.Cooldown) == "number" then cb = a4.Cooldown end
				if type(a4.Energy) == "number" then eb = a4.Energy end
				return
			end
		end
		if a5 then
			if type(a5.Cooldown) == "number" then cb = a5.Cooldown end
			if type(a5.Energy) == "number" then eb = a5.Energy end
		end
	end)
	return fb, cb, eb
end

-- Lee cooldown y costo del beam (Attack5) de TU kaiju actual
local function BeamCostCD()
	local fb, cb, eb = PickBeamSkill()
	return cb, eb, fb
end

