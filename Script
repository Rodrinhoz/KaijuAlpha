-- Clasifica una misión: tipo + dato (kaiju requerido u objetivo)
-- REGLA boss: si el texto dice "boss"/"jefe" (en cualquier posición: "Help
-- defeat boss X", "defeat boss X", "X boss"), es misión de BOSS aunque X sea
-- un kaiju jugable. Nunca se confunde con un jugador usando ese kaiju.
-- Sin palabra boss, "Defeat X" es jugador (KILL_NAMED), sin excepciones.
-- NoPlayerKills: ignora misiones de matar jugadores (KILL_NAMED, KILL_ANY)
-- NoBoss: ignora misiones de boss (BOSS)
local BOSS_WORDS = { "boss", "jefe", "jefes", "bosses" }
local function HasBossWord(s)
	for _, w in ipairs(BOSS_WORDS) do
		if s:find(w, 1, true) then return true end
	end
	return false
end
-- Kaiju que la misión EXIGE usar ("Using X defeat...", "Use X to defeat...").
-- Distinto del objetivo: en "Help defeat boss Shin Eva" el boss es objetivo,
-- no requisito (no cambia de kaiju). Devuelve nil si no hay exigencia.
local function UsingRequirement(info, owned)
	local using = info:match("[Uu]sing ([%w%s%(%)%-%.]-) [Dd]efeat")
		or info:match("[Uu]se ([%w%s%(%)%-%.]-) to [Dd]efeat")
	if not using then return nil end
	using = using:gsub("%s+$", "")
	if owned[using] then return using end
	local best = nil
	for name in pairs(owned) do
		if using:find(name, 1, true) and (not best or #name > #best) then best = name end
	end
	return best
end
-- Alias histórico (misma función).
local BossRequirement = UsingRequirement
local function ClassifyQuest(info, owned)
	local lower = info:lower()
	local noPlayerKills = Config.Quests.NoPlayerKills
	local noBoss = Config.Quests.NoBoss

	-- Kaiju requerido para la misión ("Using X...", "Use X..."): se debe
	-- jugar como él antes de farmear el objetivo.
	local requiredKaiju = FindOwnedMention(info, owned)
	-- La palabra boss manda sobre todo lo demás (incluso sobre "beam",
	-- por si un día hay "boss beam"; hoy no existe, pero es gratis).
	if HasBossWord(lower) then
		if noBoss then return "SKIP_BOSS", nil end
		return "BOSS", BossRequirement(info, owned)
	end
	-- Edificios con beam explícito ("beam ... destroy", "X's beam ...").
	if lower:find("beam") and (lower:find("destroy") or lower:find("building")) then
		return "BEAM_BUILD", requiredKaiju
	end
	-- Edificios SIN beam ("Use X to destroy N buildings", "Use any kaiju
	-- to destroy N city buildings"): vale cualquier ataque.
	if lower:find("destroy") and (lower:find("build") or lower:find("city")) then
		return "DESTROY_BUILD", requiredKaiju
	end
	local defeat, need = info:match("[Dd]efeat ([%w%s%(%)%-%.]-) (%d+) times")
	if defeat then
		defeat = defeat:gsub("%s+$", "")
		if defeat:lower():find("boss") then
			if noBoss then return "SKIP_BOSS", nil end
			return "BOSS", requiredKaiju
		end
		if defeat:lower():find("any kaiju") or defeat:match("^%d+$") then
			if noPlayerKills then return "SKIP_PLAYER", nil end
			return "KILL_ANY", nil
		end
		if noPlayerKills then return "SKIP_PLAYER", nil end
		return "KILL_NAMED", defeat
	end
	if lower:find("defeat %d+") then
		if noPlayerKills then return "SKIP_PLAYER", nil end
		return "KILL_ANY", nil
	end
	local pm = info:match("[Pp]lay ([%w%s%(%)%-%.]-) for")
	if pm then
		pm = pm:gsub("%s+$", "")
		if pm:lower():find("any kaiju") or pm == "" then return "PASSIVE", nil end
		local hit = FindOwnedMention(pm, owned) or requiredKaiju
		if hit then return "PLAY_AS", hit end
		return "IMPOSSIBLE", pm .. " (no poseído)"
	end
	if requiredKaiju and (lower:find("using") or lower:find("use ")) then
		return "PLAY_AS", requiredKaiju
	end
	if lower:find("swim") then
		-- "Swim X studs with Y": nada en ese kaiju (progresa solo).
		return "SWIM", FindOwnedMention(info, owned)
	end
	if lower:find("fly") then
		-- "Fly X studs with Y": vuela con ese kaiju (progresa solo).
		return "FLY", FindOwnedMention(info, owned)
	end
	if lower:find("walk") then
		local w = FindOwnedMention(info, owned)
		if w then return "PLAY_AS", w end
		return "PASSIVE", nil
	end
	return "PASSIVE", nil
end

