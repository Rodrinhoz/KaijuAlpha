-- Lista de jugadores para los dropdowns (todos, estén spawneados o no)
local function AllPlayerNames()
	local names = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(names, p.Name) end
	end
	table.sort(names)
	return names
end

-- Normaliza selección multi a mapa {Nombre=true} (PealLib da mapa o lista)
local function NormSet(v)
	local map = {}
	if type(v) == "table" then
		if #v > 0 then for _, a in ipairs(v) do map[a] = true end
		else for a in pairs(v) do if a then map[a] = true end end end
	end
	return map
end

local function KillValid(model)
	if not model or not model.Parent or model.Name == LocalPlayer.Name then return false end
	local h = model:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return false end
	-- Protección de spawn (IFrame): no pegarse a intocables. Exime al
	-- jefe (AI_) por si usa el atributo en alguna fase.
	if model:GetAttribute("IFrame") == true and model.Name:sub(1, 3) ~= "AI_" then return false end
	for name in pairs(Config.Kill.Exclude) do
		if model.Name == name then return false end
	end
	local hasTargets = false
	for _ in pairs(Config.Kill.Targets) do hasTargets = true break end
	if hasTargets and not Config.Kill.Targets[model.Name] then return false end
	return true
end

local function PickKillTarget()
	local now = os.clock()
	if KillValid(State.KillCurrent) and now < (State.KillNextSwitch or 0) then
		return State.KillCurrent
	end
	local cands = {}
	local live = GetLiveFolder()
	if live then
		for _, m in ipairs(live:GetChildren()) do
			if m:IsA("Model") and KillValid(m) then table.insert(cands, m) end
		end
	end
	if #cands == 0 then State.KillCurrent = nil return nil end
	State.KillCurrent = cands[math.random(1, #cands)]
	State.KillNextSwitch = now + (Config.Kill.SwitchTime or 8)
	return State.KillCurrent
end

local function KillTick()
	if not Config.Kill.Enabled or State.Unloaded then return end
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myKaiju or not myHRP then return end
	local target = PickKillTarget()
	if not target then
		-- Si el quest maneja el kill y el foco apunta a jugadores que ya no
		-- están, se limpia para no quedarse sin objetivo eternamente.
		if State.QuestDroveKill and next(Config.Kill.Targets) then
			local liveNames = {}
			pcall(function()
				for _, m in ipairs(GetEnemyKaijus()) do liveNames[m.Name] = true end
			end)
			local cleaned = false
			for name in pairs(Config.Kill.Targets) do
				if not liveNames[name] then
					Config.Kill.Targets[name] = nil
					cleaned = true
				end
			end
			if cleaned then
				pcall(function()
					local t = Tgl("KillTargets")
					if t then t:SetValue(Config.Kill.Targets) end
				end)
				target = PickKillTarget()
				if not target then return end
			else
				return
			end
		else
			return
		end
	end
	local tHRP = target:FindFirstChild("HumanoidRootPart")
	if not tHRP then return end
	-- Seguimiento con histéresis: dentro de la banda [stick/2, stick*1.5]
	-- se deja la física en paz (si no, el teleport cada frame pelea con
	-- knockbacks y se ve jitter). Fuera de la banda, snap exacto al modo.
	-- La mira sí se actualiza siempre (con deadzone anti-giros).
	-- Nada de movimiento los primeros 3s tras spawnear (asentamiento).
	local stick = Config.Kill.StickDist or 12
	local tPos = tHRP.Position
	if SpawnSettled() then
		local d = math.huge
		pcall(function() d = (tHRP.Position - myHRP.Position).Magnitude end)
		local mode = Config.Kill.PosMode or "Enfrente"
	-- Cambio de modo: un snap inmediato para que se note al instante.
	local modeChanged = State.KillPosModeLast ~= nil and State.KillPosModeLast ~= mode
	State.KillPosModeLast = mode
	if modeChanged or d > stick * 1.5 or d < stick * 0.5 then
		local tLook = tHRP.CFrame.LookVector
		tLook = Vector3.new(tLook.X, 0, tLook.Z)
		if tLook.Magnitude < 0.001 then tLook = Vector3.new(0, 0, 1) end
		tLook = tLook.Unit
		local dest
		if mode == "Arriba" then
			dest = Vector3.new(tPos.X, tPos.Y + stick, tPos.Z)
		elseif mode == "Abajo" then
			dest = Vector3.new(tPos.X, tPos.Y - stick, tPos.Z)
		elseif mode == "Atrás" then
			dest = Vector3.new(tPos.X - tLook.X * stick, tPos.Y, tPos.Z - tLook.Z * stick)
		else -- "Enfrente"
			dest = Vector3.new(tPos.X + tLook.X * stick, tPos.Y, tPos.Z + tLook.Z * stick)
		end
		pcall(function()
			myHRP.CFrame = CFrame.lookAt(dest, tPos)
		end)
	else
		pcall(function()
			local want = tPos - myHRP.Position
			if want.Magnitude > 1 then
				local cur = myHRP.CFrame.LookVector
				if math.acos(math.clamp(cur:Dot(want.Unit), -1, 1)) > 0.17 then
					myHRP.CFrame = CFrame.lookAt(myHRP.Position, tPos)
				end
			end
		end)
	end
	end
	-- Rotación simple por los ataques activados, sin reservas ni gating:
	-- el servidor rechaza lo que esté en cooldown/sin energía. Ritmo
	-- propio, separado del seguimiento.
	local now = os.clock()
	if now >= (State.KillNextAttack or 0) then
		local order = { "Attack1", "Attack2", "Attack3", "Attack4", "Attack5" }
		local list = {}
		for _, a in ipairs(order) do
			if Config.Kill.Attacks[a] then table.insert(list, a) end
		end
		if #list == 0 then list = { "Attack1" } end
		State.KillAttackIdx = ((State.KillAttackIdx or 0) % #list) + 1
		FireSkill(list[State.KillAttackIdx])
		State.KillNextAttack = now + (Config.Kill.Interval or 1.2)
	end
end

-- Auto respawn REAL: configura la isla en el menú (como el juego manda)
-- y pulsa el botón Spawn por ti. Sin teleports chapuza.
local SPAWN_INDEX = { Tokyo = 1, ["Isla de Mara"] = 2, Antarctica = 3, Desert = 4, ["Skull Island"] = 5 }

local function FindSpawnButton()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local menu = pg and pg:FindFirstChild("Menu")
	if not menu then return nil end
	for _, d in ipairs(menu:GetDescendants()) do
		if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Name == "Spawn" then
			return d
		end
	end
	return nil
end

-- Pone la isla en la selección del menú (ya NO toca tu kaiju: eso lo
-- maneja el dropdown "Seleccionar kaiju")
local function SetSpawnSelection(islandIdx)
	if typeof(getconnections) ~= "function" or typeof(debug.getupvalues) ~= "function" then return false end
	local done = false
	pcall(function()
		local b = FindSpawnButton()
		if not b then return end
		for _, conn in ipairs(getconnections(b.MouseButton1Click)) do
			local f = conn.Function
			if type(f) == "function" then
				for _, up in ipairs(debug.getupvalues(f)) do
					if type(up) == "table" then
						if rawget(up, "IslandIndex") ~= nil and islandIdx then
							up.IslandIndex = islandIdx
							done = true
						end
					end
				end
			end
		end
	end)
	return done
end

local function PressSpawn()
	if typeof(getconnections) ~= "function" then return false end
	local pressed = false
	pcall(function()
		local b = FindSpawnButton()
		if not b then return end
		for _, conn in ipairs(getconnections(b.MouseButton1Click)) do
			local f = conn.Function
			if type(f) == "function" and pcall(f) then
				pressed = true
				break
			end
		end
	end)
	return pressed
end

-- Spawnea en la isla pedida como el juego manda. "Actual" = Tokyo y luego
-- vuelve solo a tu última posición guardada. "Safezone" = Tokyo + tp.
local function SpawnOnIsland(name)
	local idx = SPAWN_INDEX[name]
	if idx then
		SetSpawnSelection(idx)
		return PressSpawn()
	end
	if name == "Safezone" then
		SetSpawnSelection(1)
		if PressSpawn() then
			State.PendingIslandTp = "Safezone"
			return true
		end
		return false
	end
	-- "Actual" u otra: Tokyo y vuelta a la posición guardada
	SetSpawnSelection(1)
	if PressSpawn() then
		State.PendingIslandTp = "Actual"
		return true
	end
	return false
end

-- Kaijus que POSEES (inventario real, no todos los del juego)
local function GetOwnedKaijus()
	local list = {}
	pcall(function()
		local data = ReplicatedStorage:FindFirstChild("Data")
		local mine = data and data:FindFirstChild(LocalPlayer.UserId .. "_Data")
		local inv = mine and mine:FindFirstChild("KaijuInventory")
		if not inv then return end
		for _, k in ipairs(inv:GetChildren()) do
			table.insert(list, k.Name)
		end
	end)
	table.sort(list)
	return list
end

-- Selecciona un kaiju (SOLO poseídos): clic en su tarjeta + EQUIP real
-- al servidor (FireServer "Select"). Sin el Equip, el spawn ignora la
-- selección y usa el anterior.
local function SelectKaiju(name)
	if not name or name == "" then return false end
	local owned = false
	pcall(function()
		local data = ReplicatedStorage:FindFirstChild("Data")
		local mine = data and data:FindFirstChild(LocalPlayer.UserId .. "_Data")
		local inv = mine and mine:FindFirstChild("KaijuInventory")
		owned = inv and inv:FindFirstChild(name) ~= nil
	end)
	if not owned then
		Notify(name .. " no poseído", 3)
		return false
	end
	pcall(function()
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		local menu = pg and pg:FindFirstChild("Menu")
		local cont = menu and menu:FindFirstChild("Kaiju")
		cont = cont and cont:FindFirstChild("Container")
		local frame = cont and cont:FindFirstChild(name)
		local btn = frame and frame:FindFirstChildWhichIsA("TextButton", true)
		if btn then
			for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
				local f = conn.Function
				if type(f) == "function" then pcall(f) end
			end
		end
	end)
	local ok = false
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local fs = remotes and remotes:FindFirstChild("FireServer")
		if fs then
			fs:FireServer("Select", name)
			ok = true
		end
	end)
	return ok
end

local function RespawnTick()
	if State.Unloaded then return end
	-- Solo presiona Spawn si algún autorespawn está activado o si el
	-- botón SPAWN lo pidió una vez (ForceRespawnOnce).
	local bossWanted = Config.BossFarm.Enabled and Config.BossFarm.AutoRespawn and FindBoss() ~= nil
	local questWanted = Config.Quests.Auto
	local wantRespawn = Config.Respawn.Auto or bossWanted or questWanted or State.ForceRespawnOnce
	local fast = Config.BossFarm.Enabled
	local now = os.clock()
	local period = fast and 0.25 or 1
	if (now - (State.LastRespawnCheck or 0)) < period then return end
	State.LastRespawnCheck = now
	local myKaiju = GetMyKaiju(false)
	local hum = myKaiju and myKaiju:FindFirstChildOfClass("Humanoid")
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	local alive = myKaiju and hum and hum.Health > 0
	if alive and myHRP then
		-- Guarda tu posición cada poco para el modo "Actual"
		if (now - (State.LastPosSave or 0)) > 5 then
			State.LastPosSave = now
			State.LastPos = myHRP.CFrame
		end
	end
	if not alive then
		State.WaitingRespawn = true
		if not wantRespawn then return end
		local retryEvery = fast and 1.5 or 5
		if (now - (State.LastSpawnTry or 0)) > retryEvery then
			State.LastSpawnTry = now
			if SpawnOnIsland(Config.Respawn.Island) then
				Notify("Spawneando en " .. Config.Respawn.Island .. "...", 3)
			elseif not fast then
				Notify("Pulsa Play + Spawn manual", 4)
			end
		end
		return
	end
	if State.WaitingRespawn then
		State.WaitingRespawn = false
		State.ForceRespawnOnce = false
		State.MyKaijuCache = myKaiju
		-- Con BossFarm: vuelve al JEFE solo si el farm y su autorespawn
		-- siguen activos Y el jefe sigue vivo (se re-verifica al llegar).
		if Config.BossFarm.Enabled and Config.BossFarm.AutoRespawn then
			local boss = FindBoss()
			local bHRP = boss and boss:FindFirstChild("HumanoidRootPart")
			local bHum = boss and boss:FindFirstChildOfClass("Humanoid")
			if bHRP and bHum and bHum.Health > 0 then
				task.delay(1, function()
					if State.Unloaded then return end
					local b2 = FindBoss()
					local bHRP2 = b2 and b2:FindFirstChild("HumanoidRootPart")
					local bHum2 = b2 and b2:FindFirstChildOfClass("Humanoid")
					if not (bHRP2 and bHum2 and bHum2.Health > 0) then return end
					local mk = GetMyKaiju(false)
					local hrp = mk and mk:FindFirstChild("HumanoidRootPart")
					if hrp then
						pcall(function()
							hrp.CFrame = CFrame.new(bHRP2.Position + Vector3.new(0, 5, 20))
						end)
						Notify("De vuelta al jefe", 3)
					end
				end)
				State.PendingIslandTp = nil
				return
			end
		end
		if Config.Respawn.Auto and State.PendingIslandTp == "Actual" and State.LastPos then
			local dest = State.LastPos
			task.delay(1, function()
				if not State.Unloaded then
					local mk = GetMyKaiju(false)
					local hrp = mk and mk:FindFirstChild("HumanoidRootPart")
					if hrp then pcall(function() hrp.CFrame = dest end) end
					Notify("De vuelta a tu posición", 3)
				end
			end)
		elseif Config.Respawn.Auto and State.PendingIslandTp == "Safezone" then
			task.delay(1, function()
				if not State.Unloaded and TeleportIsland("Safezone") then
					Notify("Reaparecido en Safezone", 3)
				end
			end)
		else
			Notify("Reaparecido en " .. Config.Respawn.Island, 3)
		end
		State.PendingIslandTp = nil
	end
end

-- ================= VOTEKICK AUTO =================
-- El juego vota por remotes: StartVote(nombre) abre votación, Vote(nombre,
-- true/false) vota. Las votaciones activas se ven en Vote_List (UI del
-- juego): si ya hay una contra alguien, no se abre otra, solo se vota.
local function GetVoteRemote()
	if State.VoteRemote and State.VoteRemote.Parent then return State.VoteRemote end
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		State.VoteRemote = remotes and remotes:FindFirstChild("VoteRemote")
	end)
	return State.VoteRemote
end

local function GetVoteList()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local vk = pg and pg:FindFirstChild("Votekick")
	return vk and vk:FindFirstChild("Vote_List")
end

local function IsExcludedVote(name)
	if name == LocalPlayer.Name then return true end
	return Config.Vote.Exclude[name] == true
end

local function PollActive(target)
	local vl = GetVoteList()
	return vl and vl:FindFirstChild(target) ~= nil
end

local function SendVote(target, yes)
	local vr = GetVoteRemote()
	if vr then pcall(vr.FireServer, vr, "Vote", target, yes) end
end

local function StartVoteFor(target)
	if target == LocalPlayer.Name or PollActive(target) then return false end
	local vr = GetVoteRemote()
	if not vr then return false end
	local ok = pcall(vr.FireServer, vr, "StartVote", target)
	return ok
end

-- Escucha votaciones de TODOS: vota SÍ auto (o NO si es excluido/amigo).
local function HookVoteEvents()
	local vr = GetVoteRemote()
	if not vr then return end
	pcall(function()
		TrackConn(vr.OnClientEvent:Connect(function(kind, ...)
			if State.Unloaded then return end
			local args = { ... }
			if kind == "NewVote" then
				local target = args[1]
				if type(target) ~= "string" or State.Voted[target] then return end
				State.Voted[target] = true
				-- Excluidos: abstención total, siempre (sin botones ni opciones)
				if IsExcludedVote(target) then return end
				if Config.Vote.AutoYes then
					SendVote(target, true)
				end
			elseif kind == "EndVote" then
				State.Voted[args[1]] = nil
			end
		end))
	end)
end

local function VoteCandidates()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and not IsExcludedVote(p.Name) and not PollActive(p.Name) then
			table.insert(list, p.Name)
		end
	end
	table.sort(list)
	return list
end

local function VoteTick()
	if State.Unloaded then return end
	local now = os.clock()
	if (now - (State.LastVoteTick or 0)) < 5 then return end
	State.LastVoteTick = now
	-- Amigos auto: re-escanea cada 30s por si entra/sale gente
	if Config.Vote.AutoFriends and (now - (State.LastFriendScan or 0)) > 30 then
		State.LastFriendScan = now
		ExcludeFriends()
		pcall(SyncExcludeDrop)
	end
	-- Auto a todos: abre TODAS las faltantes con 1s entre cada una
	-- (probado: a ese ritmo las 10 conviven; más rápido se comen disparos)
	-- "Solo seleccionados" manda: si tiene gente, SOLO ellos (aunque
	-- AutoAll esté ON). Vacío = todos (respeta exclusiones, siempre).
	if Config.Vote.AutoAll and not State.VoteWorking then
		State.VoteWorking = true
		task.spawn(function()
			local targets = {}
			for name in pairs(Config.Vote.Solo) do
				if name ~= LocalPlayer.Name and not IsExcludedVote(name) and Players:FindFirstChild(name) then
					table.insert(targets, name)
				end
			end
			if #targets == 0 then targets = VoteCandidates() end
			table.sort(targets)
			for _, name in ipairs(targets) do
				if State.Unloaded or not Config.Vote.AutoAll then break end
				if not PollActive(name) then StartVoteFor(name) end
				task.wait(1)
			end
			State.VoteWorking = false
		end)
	end
end

-- Detecta amigos en el servidor y los mete a exclusiones
local function ExcludeFriends()
	local added = 0
	pcall(function()
		local inServer = {}
		for _, p in ipairs(Players:GetPlayers()) do inServer[p.UserId] = p.Name end
		local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
		while true do
			for _, item in ipairs(pages:GetCurrentPage()) do
				local name = inServer[item.Id]
				if name and not Config.Vote.Exclude[name] then
					Config.Vote.Exclude[name] = true
					added += 1
				end
			end
			if pages.IsFinished then break end
			pages:AdvanceToNextPageAsync()
		end
	end)
	return added
end

-- Refresca el dropdown de exclusiones con la lista y selección actuales
local function SyncExcludeDrop()
	local drop = State.VoteExcludeDrop
	if not drop then return end
	local names = AllPlayerNames()
	pcall(function() drop:Refresh(names) end)
	pcall(function()
		local map = {}
		for name in pairs(Config.Vote.Exclude) do map[name] = true end
		drop:SetValue(map)
	end)
end

-- ================= BOSS MONITOR =================
-- No hay temporizador visible en el juego: se detecta al jefe por el tag
-- BossBarTarget (el mismo que usa su barra de vida) + modelos AI_ con HP alto.
-- Zona de espera = BossPortal (1916,77,873).
local BOSS_PORTAL = Vector3.new(1916, 82, 873)

FindBoss = function()
	for _, m in ipairs(game:GetService("CollectionService"):GetTagged("BossBarTarget")) do
		if m.Parent then
			local h = m:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then return m end
		end
	end
	local live = GetLiveFolder()
	if live then
		for _, m in ipairs(live:GetChildren()) do
			if m:IsA("Model") and (m.Name:sub(1, 3) == "AI_" or m.Name:find("Boss")) then
				local h = m:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 then return m end
			end
		end
	end
	return nil
end

local function GoBossPortal()
	local myKaiju = GetMyKaiju()
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then Notify("Spawnea primero", 3) return false end
	if not SpawnSettled() then return false end
	pcall(function() myHRP.CFrame = CFrame.new(BOSS_PORTAL) end)
	Notify("En zona boss (portal)", 3)
	return true
end

local function FindBossTimer()
	if State.BossTimerLabel and State.BossTimerLabel.Parent then
		return State.BossTimerLabel
	end
	State.BossTimerLabel = nil
	pcall(function()
		local map = Workspace:FindFirstChild("Map")
		if not map then return end
		for _, d in ipairs(map:GetDescendants()) do
			if d:IsA("TextLabel") and d.Name == "TextLabel" then
				local p = d.Parent
				if p and p.Name == "BossTimer" then
					State.BossTimerLabel = d
					break
				end
			end
		end
	end)
	return State.BossTimerLabel
end

-- Lee "Boss Spawn In\nMM:SS\n(presentes/requeridos)" -> secs, present, req
local function ReadBossTimer()
	local lbl = FindBossTimer()
	if not lbl then return nil end
	local txt = nil
	pcall(function() txt = lbl.Text end)
	if type(txt) ~= "string" then return nil end
	local m, s = txt:match("(%d+):(%d+)")
	local p, r = txt:match("%((%d+)/(%d+)%)")
	if not m then return nil end
	return tonumber(m) * 60 + tonumber(s), p and tonumber(p), r and tonumber(r)
end

-- Nombre limpio: "AI_Shin Eva Godzilla_1" -> "Shin Eva Godzilla"
local function BossPrettyName(b)
	local n = b.Name
	n = n:gsub("^AI_", "")
	n = n:gsub("_[%d]+$", "")
	n = n:gsub("_", " ")
	return n
end

local function BossTick()
	if State.Unloaded then return end
	local now = os.clock()
	if (now - (State.LastBossCheck or 0)) < 1 then return end
	State.LastBossCheck = now
	-- Display limpio: cuanto falta + cuántos hay (el extra ya viene en el contador)
	local secs, present, req = ReadBossTimer()
	if secs then
		pcall(function()
			if State.BossTimerLbl then
				State.BossTimerLbl:SetText(string.format("Falta: %d:%02d", math.floor(secs / 60), secs % 60))
			end
		end)
		pcall(function()
			if State.BossPlayersLbl then
				present = present or 0
				req = req or 3
				local extra = present >= req and " (listo)" or string.format(" (faltan %d)", req - present)
				State.BossPlayersLbl:SetText(string.format("En zona: %d/%d%s", present, req, extra))
			end
		end)
		local prev = State.LastBossSecs
		State.LastBossSecs = secs
		for _, mark in ipairs({ 60, 30, 10 }) do
			if prev and prev > mark and secs <= mark then
				Notify(string.format("Boss en %d segundos (%d/%d)", mark, present or 0, req or 3), 4)
			end
		end
	end
	local b = FindBoss()
	pcall(function()
		if State.BossStateLbl then
			if b then
				local h = b:FindFirstChildOfClass("Humanoid")
				State.BossStateLbl:SetText("Vida del jefe: " .. (h and tostring(math.floor(h.Health)) or "--"))
			else
				State.BossStateLbl:SetText("Vida del jefe: --")
			end
		end
	end)
	if b then
		pcall(function()
			if State.BossDmgLbl then
				local txt = "Daño causado: --"
				local ok, board = pcall(function() return b:GetAttribute("DamageBoard") end)
				if ok and type(board) == "string" and #board > 2 then
					local ok2, arr = pcall(HttpService.JSONDecode, HttpService, board)
					if ok2 and type(arr) == "table" then
						local total, mine = 0, 0
						for _, e in ipairs(arr) do
							local d = tonumber(e.d) or 0
							total = total + d
							if e.n == LocalPlayer.Name then mine = d end
						end
						if total > 0 then
							txt = string.format("Daño causado: %d (\"%.1f%%\")", math.floor(mine), mine / total * 100)
						end
					end
				end
				State.BossDmgLbl:SetText(txt)
			end
		end)
	end
	if b then
		if not State.BossActive then
			State.BossActive = true
			-- REGLA sala de espera: solo cuenta si estabas en la zona del
			-- portal antes de que iniciara. Si el boss ya inició sin ti,
			-- el daño NO cuenta para misiones ni autofarm.
			local inWait = (os.clock() - (State.LastWaitSeen or -1e9)) < 90
			State.BossStartedWithMe = inWait
			if inWait then
				Notify("JEFE APARECIÓ: " .. BossPrettyName(b), 5)
			else
				Notify("Jefe inició sin ti (no cuenta para misiones)", 5)
			end
		end
		State.LastBossSeenAt = now
	else
		State.BossActive = false
		State.BossStartedWithMe = false
	end
	-- Marca presencia en sala de espera: timer visible + cerca del portal.
	-- Se evalúa cada segundo en BossTick (barato, sin raycasts).
	if secs then
		local myKaiju = GetMyKaiju(false)
		local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
		if myHRP then
			local d = math.huge
			pcall(function() d = (myHRP.Position - BOSS_PORTAL).Magnitude end)
			if d < 200 then
				State.InBossWait = true
				State.LastWaitSeen = now
			elseif (now - (State.LastWaitSeen or -1e9)) > 90 then
				State.InBossWait = false
			end
		end
	end
end

-- ================= BOSS AUTOFARM + EVASOR =================
-- El jefe no avisa por atributos: sus ataques se ven como partes
-- Hitbox_<NombreJefe> en Debris (34³ lo normal, hasta 150³ los especiales).
-- Farm: pegado al jefe spameando Attack1. Evasor: al nacer su hitbox cerca
-- tuyo, sube +100 y vuelve (los especiales no llegan tan alto).
-- Pegado con WeldConstraint (no existe en la lista negra del Anti):
-- te sueldas detrás del jefe y la física te lleva con él, suave,
-- sin teleports a cada rato. Al girar él, sigues detrás.
local function UnweldBoss()
	pcall(function()
		if State.BossWeld then State.BossWeld:Destroy() end
	end)
	State.BossWeld = nil
end

local function WeldToBoss(myHRP, bHRP)
	UnweldBoss()
	local ok = pcall(function()
		local w = Instance.new("WeldConstraint")
		w.Name = "KaijuHubWeld"
		w.Part0 = myHRP
		w.Part1 = bHRP
		w.Parent = myHRP
	end)
	if ok then
		State.BossWeld = myHRP:FindFirstChild("KaijuHubWeld")
	end
end

local function BossHitboxName(boss)
	return boss and ("Hitbox_" .. boss.Name) or nil
end

local function OnBossHitbox(part)
	if State.Unloaded or not Config.BossFarm.Enabled or not Config.BossFarm.Dodge then return end
	if not part:IsA("BasePart") then return end
	local boss = FindBoss()
	if not boss or part.Name ~= BossHitboxName(boss) then return end
	if State.BossDodging then return end
	local myKaiju = GetMyKaiju(false)
	local myHRP = myKaiju and myKaiju:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end
	local d
	pcall(function() d = (part.Position - myHRP.Position).Magnitude end)
	if not d or d > 100 then return end
	State.BossDodging = true
	UnweldBoss()
	task.spawn(function()
		local orig = myHRP.CFrame
		-- Escape según el TAMAÑO REAL de la hitbox (especiales de 150
		-- llegan a 75; melee de 34 con 60 sobra). Plataforma = sin caídas.
		local sz = 34
		pcall(function()
			sz = math.max(part.Size.X, part.Size.Y, part.Size.Z)
		end)
		local top = orig.Position + Vector3.new(0, math.max(60, sz / 2 + 40), 0)
		EnsureSkyPlatform(top)
		pcall(function()
			myHRP.CFrame = CFrame.new(Vector3.new(top.X, top.Y + 4, top.Z))
		end)
		-- Vuelve cuando LA HITBOX MUERE (+0.3s), no a tiempo fijo.
		-- Así no regresas en mitad del especial de 2s ni esperas de más.
		local t0 = os.clock()
		while os.clock() - t0 < 2.5 and not State.Unloaded do
			if not part.Parent then task.wait(0.3) break end
			task.wait(0.1)
		end
		pcall(function()
			if myHRP.Parent and not State.Unloaded then myHRP.CFrame = orig end
		end)
		State.BossDodging = false
	end)
end

local function StartBossFarm()
	StopBossFarm()
	local map = Workspace:FindFirstChild("Map")
	local debris = map and map:FindFirstChild("Debris")
	if debris then
		table.insert(State.BossFarmConns, debris.DescendantAdded:Connect(OnBossHitbox))
	end
	local live = GetLiveFolder()
	if live then
		table.insert(State.BossFarmConns, live.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then OnBossHitbox(d) end
		end))
	end
